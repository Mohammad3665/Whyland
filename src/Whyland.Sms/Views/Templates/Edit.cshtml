@model TemplateFormViewModel
@{
  ViewData["Title"] = Model.IsNew ? "قالب جدید" : $"ویرایش {Model.Code}";

  var action = Model.IsNew ? "Create" : "Edit";
  var preview = ViewBag.Preview as RenderOutcome;

  // The create form always carries one blank row so the table below never renders empty.
  if (Model.Parameters.Count == 0)
  {
    Model.Parameters.Add(new TemplateParameterFormModel());
  }
}

<div class="mb-5">
  <a asp-controller="Templates" asp-action="Index"
    class="inline-flex items-center gap-1 text-xs font-semibold text-body transition-colors hover:text-primary sm:text-sm">
    ← بازگشت به قالب‌ها
  </a>
  <h1 class="mt-2 text-xl font-bold sm:text-2xl">
    @if (Model.IsNew)
    {
      <text>قالب جدید</text>
    }
    else
    {
      <text>ویرایش قالب <code dir="ltr" class="font-mono text-base">@Model.Code</code></text>
    }
  </h1>
  <p class="mt-1 text-xs leading-relaxed text-body sm:text-sm">
    ذخیره از همان اعتبارسنجی <code dir="ltr">SmsTemplateEditor</code> عبور می‌کند که API استفاده می‌کند؛
    چیزی که اینجا ذخیره شود، با <code dir="ltr">POST /api/v1/sms/send</code> هم پذیرفته می‌شود.
  </p>
</div>

<partial name="_Validation" />

@if (preview is not null)
{
  <div class="mb-5 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <h2 class="mb-2 text-sm font-bold sm:text-base">پیش‌نمایش با مقادیر نمونه</h2>
    @if (preview.IsSuccess)
    {
      <p class="whitespace-pre-wrap rounded-xl bg-success-light p-4 text-xs leading-loose text-dark sm:text-sm">
        @preview.Content
      </p>
      <p class="mt-2 text-[11px] text-gray-400">
        این متن جایی ذخیره یا ارسال نمی‌شود؛ فقط برای دیدن جاافتادن پارامترهاست.
      </p>
    }
    else
    {
      <div class="rounded-xl bg-danger-light p-4 text-xs leading-relaxed sm:text-sm">
        <p class="font-semibold text-danger"><code dir="ltr">@preview.ErrorCode</code></p>
        <p class="mt-1 text-body">@preview.ErrorMessage</p>
        @if (!string.IsNullOrWhiteSpace(preview.Field))
        {
          <p class="mt-1 text-body">پارامتر مربوطه: <code dir="ltr">@preview.Field</code></p>
        }
      </div>
    }
  </div>
}

<div class="grid gap-4 lg:grid-cols-3">
  <form class="lg:col-span-2 space-y-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm"
    asp-controller="Templates" asp-action="@action" asp-route-code="@Model.Code" method="post">

    <input type="hidden" name="IsNew" value="@(Model.IsNew ? "true" : "false")" />

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label asp-for="Code" class="mb-1.5 block text-xs font-semibold sm:text-sm">کد قالب</label>
        @if (Model.IsNew)
        {
          <input asp-for="Code" dir="ltr" placeholder="SMS-OTP-001"
            class="h-10 w-full rounded-xl border border-gray-200 bg-white px-4 text-right text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
        }
        else
        {
          <input type="hidden" name="Code" value="@Model.Code" />
          <input value="@Model.Code" readonly dir="ltr"
            class="h-10 w-full rounded-xl border border-gray-100 bg-light px-4 text-right text-xs text-gray-400 outline-none sm:text-sm" />
        }
        <p class="mt-1.5 text-[11px] leading-relaxed text-gray-400">
          با الگوی <code dir="ltr">@SmsTemplateEditor.CodePattern</code> می‌خواند و به حروف بزرگ تبدیل می‌شود؛
          بعد از ساخت قابل تغییر نیست.
        </p>
      </div>

      <div>
        <label asp-for="Name" class="mb-1.5 block text-xs font-semibold sm:text-sm">نام نمایشی</label>
        <input asp-for="Name" placeholder="کد ورود"
          class="h-10 w-full rounded-xl border border-gray-200 bg-white px-4 text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
      </div>
    </div>

    <div>
      <label asp-for="Content" class="mb-1.5 block text-xs font-semibold sm:text-sm">متن پیام</label>
      <textarea asp-for="Content" rows="4" placeholder="کد ورود شما: {{Code}}"
        class="w-full rounded-xl border border-gray-200 bg-white p-4 text-xs leading-loose outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm"></textarea>
      <p class="mt-1.5 text-[11px] leading-relaxed text-gray-400">
        جای‌نماها به شکل <code dir="ltr">{{Name}}</code> نوشته می‌شوند و باید با پارامترهای زیر هم‌نام باشند.
      </p>
    </div>

    <div>
      <label asp-for="Description" class="mb-1.5 block text-xs font-semibold sm:text-sm">توضیح داخلی</label>
      <input asp-for="Description" placeholder="برای چه جریانی استفاده می‌شود؟"
        class="h-10 w-full rounded-xl border border-gray-200 bg-white px-4 text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
    </div>

    <div class="rounded-xl border border-gray-100 bg-light p-4">
      <div class="mb-3 flex items-center justify-between gap-2">
        <h2 class="text-xs font-bold sm:text-sm">پارامترهای قالب</h2>
        <button type="button" id="add-parameter"
          class="cursor-pointer rounded-full border border-gray-200 bg-white px-3 py-1.5 text-[11px] font-semibold text-primary transition-all hover:border-primary/40 active:scale-[0.98]">
          + افزودن پارامتر
        </button>
      </div>

      <div id="parameters" class="space-y-3">
        @for (var i = 0; i < Model.Parameters.Count; i++)
        {
          var parameter = Model.Parameters[i];
          <div class="parameter-row rounded-xl border border-gray-100 bg-white p-3" data-row>
            <div class="grid gap-2 sm:grid-cols-12">
              <input class="sm:col-span-3 h-9 rounded-lg border border-gray-200 bg-white px-3 text-[11px] outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary"
                name="Parameters[@i].Name" placeholder="Name" data-field="Name" value="@parameter.Name" dir="ltr" />
              <select class="sm:col-span-2 h-9 cursor-pointer rounded-lg border border-gray-200 bg-white px-2 text-[11px] outline-none focus:border-primary"
                name="Parameters[@i].Type" data-field="Type" dir="ltr">
                <option value="string" selected="@(parameter.Type != "integer")">string</option>
                <option value="integer" selected="@(parameter.Type == "integer")">integer</option>
              </select>
              <input class="sm:col-span-3 h-9 rounded-lg border border-gray-200 bg-white px-3 text-[11px] outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary"
                name="Parameters[@i].DefaultValue" placeholder="پیش‌فرض (اختیاری)" data-field="DefaultValue" value="@parameter.DefaultValue" />
              <select class="sm:col-span-2 h-9 cursor-pointer rounded-lg border border-gray-200 bg-white px-2 text-[11px] outline-none focus:border-primary"
                name="Parameters[@i].Required" data-field="Required" dir="ltr">
                <option value="true" selected="@parameter.Required">اجباری</option>
                <option value="false" selected="@(!parameter.Required)">اختیاری</option>
              </select>
              <div class="sm:col-span-2 flex items-center justify-end">
                <button type="button" data-remove
                  class="cursor-pointer rounded-full border border-gray-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-danger transition-all hover:border-danger/40 hover:bg-danger-light">
                  حذف
                </button>
              </div>
            </div>
            <input class="mt-2 h-9 w-full rounded-lg border border-gray-100 bg-light px-3 text-[11px] outline-none focus:border-primary focus:ring-1 focus:ring-primary"
              name="Parameters[@i].Description" placeholder="توضیح پارامتر (اختیاری)" data-field="Description" value="@parameter.Description" />
          </div>
        }
      </div>

      <p class="mt-3 text-[11px] leading-relaxed text-gray-400">
        ردیفی که نامش خالی بماند ذخیره نمی‌شود. مقدار پیش‌فرض فقط وقتی استفاده می‌شود که پارامتر اختیاری باشد و
        فرشنده آن را نفرستد.
      </p>
    </div>

    <label class="flex cursor-pointer items-center gap-2">
      <input asp-for="IsActive" type="checkbox" class="size-4 cursor-pointer accent-[#ff5a1f]" />
      <span class="select-none text-xs text-body sm:text-sm">فعال — قالب‌های غیرفعال در زمان ارسال رد می‌شوند</span>
    </label>

    <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
      <button type="submit"
        class="cursor-pointer rounded-full bg-primary px-5 py-2.5 text-xs font-semibold text-white transition-all hover:bg-primary/90 active:scale-[0.98] sm:text-sm">
        ذخیرهٔ قالب
      </button>
      <button type="submit" asp-action="Preview" asp-route-code="@Model.Code"
        class="cursor-pointer rounded-full border border-gray-200 bg-white px-5 py-2.5 text-xs font-semibold text-dark/70 transition-all hover:border-gray-300 hover:text-dark active:scale-[0.98] sm:text-sm">
        پیش‌نمایش
      </button>
      <a asp-controller="Templates" asp-action="Index"
        class="px-2 text-xs font-semibold text-body transition-colors hover:text-primary sm:text-sm">انصراف</a>
    </div>
  </form>

  <aside class="space-y-4">
    <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
      <h2 class="mb-3 text-sm font-bold sm:text-base">مثال فراخوان</h2>
      <pre dir="ltr" class="overflow-x-auto rounded-xl bg-dark p-4 text-left text-[11px] leading-relaxed text-white sm:text-xs">{
  "to": "09120000000",
  "templateCode": "@(string.IsNullOrWhiteSpace(Model.Code) ? "SMS-OTP-001" : Model.Code)",
  "parameters": {
    "Code": "123456"
  }
}</pre>
      <p class="mt-3 text-[11px] leading-relaxed text-gray-400">
        هدر <code dir="ltr">X-Sms-Api-Key</code> هم لازم است. پارامتر اضافه در بدنه خطای
        <code dir="ltr">UnknownTemplateParameter</code> می‌دهد.
      </p>
    </div>

    <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
      <h2 class="mb-3 text-sm font-bold sm:text-base">قواعد ذخیره</h2>
      <ul class="list-disc space-y-2 pr-4 text-[11px] leading-relaxed text-body marker:text-primary">
        <li>حداقل یک پارامتر باید تعریف شود.</li>
        <li>هر <code dir="ltr">{{token}}</code> داخل متن باید یک پارامتر هم‌نام داشته باشد.</li>
        <li>نام پارامتر با حرف شروع می‌شود و فقط حرف، رقم یا <code dir="ltr">_</code> می‌پذیرد.</li>
        <li>نوع فقط <code dir="ltr">string</code> یا <code dir="ltr">integer</code> است.</li>
        <li>طول متن نهایی هنگام ارسال با <code dir="ltr">MaxMessageLength</code> کنترل می‌شود.</li>
      </ul>
    </div>

    <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
      <h2 class="mb-3 text-sm font-bold sm:text-base">بودجهٔ حافظه</h2>
      <p class="text-[11px] leading-relaxed text-body">
        قالب‌ها مثل پیام‌ها در حافظهٔ فرآیند هستند. بعد از ری‌استارت، seed پیش‌فرض دوباره ساخته می‌شود اما
        قالب‌هایی که اینجا ساخته‌اید باقی نمی‌مانند.
      </p>
    </div>
  </aside>
</div>

@section Scripts {
  <template id="parameter-row-template">
    <div class="parameter-row rounded-xl border border-gray-100 bg-white p-3" data-row>
      <div class="grid gap-2 sm:grid-cols-12">
        <input class="sm:col-span-3 h-9 rounded-lg border border-gray-200 bg-white px-3 text-[11px] outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary"
          placeholder="Name" data-field="Name" dir="ltr" />
        <select class="sm:col-span-2 h-9 cursor-pointer rounded-lg border border-gray-200 bg-white px-2 text-[11px] outline-none focus:border-primary"
          data-field="Type" dir="ltr">
          <option value="string">string</option>
          <option value="integer">integer</option>
        </select>
        <input class="sm:col-span-3 h-9 rounded-lg border border-gray-200 bg-white px-3 text-[11px] outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary"
          placeholder="پیش‌فرض (اختیاری)" data-field="DefaultValue" />
        <select class="sm:col-span-2 h-9 cursor-pointer rounded-lg border border-gray-200 bg-white px-2 text-[11px] outline-none focus:border-primary"
          data-field="Required" dir="ltr">
          <option value="true">اجباری</option>
          <option value="false">اختیاری</option>
        </select>
        <div class="sm:col-span-2 flex items-center justify-end">
          <button type="button" data-remove
            class="cursor-pointer rounded-full border border-gray-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-danger transition-all hover:border-danger/40 hover:bg-danger-light">
            حذف
          </button>
        </div>
      </div>
      <input class="mt-2 h-9 w-full rounded-lg border border-gray-100 bg-light px-3 text-[11px] outline-none focus:border-primary focus:ring-1 focus:ring-primary"
        placeholder="توضیح پارامتر (اختیاری)" data-field="Description" />
    </div>
  </template>

  <script src="~/panel/parameters.js" asp-append-version="true"></script>
}
