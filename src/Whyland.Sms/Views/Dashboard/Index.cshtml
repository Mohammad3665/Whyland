@model DashboardViewModel
@{
  ViewData["Title"] = "داشبورد";

  var cards = new (string Label, int Value, string Tone, string Hint)[]
  {
    ("پیام‌های ثبت‌شده", Model.MessageCount, "bg-info-light text-info", "متن نهایی هر ارسال موفق"),
    ("فراخوان‌های API", Model.RequestCount, "bg-light text-dark", "هر درخواستی که به سرویس رسیده"),
    ("درخواست‌های ناموفق", Model.FailedRequestCount, "bg-danger-light text-danger", "شمارش از لاگ درخواست‌ها"),
    ("قالب‌ها", Model.TemplateCount, "bg-warning-light text-warning", "قالب‌های آمادهٔ ارسال"),
  };
}

<div class="mb-6">
  <h1 class="text-xl font-bold sm:text-2xl">وضعیت شبیه‌ساز پیامک</h1>
  <p class="mt-1 text-xs leading-relaxed text-body sm:text-sm">
    شمارش‌ها روی حداکثر
    <span dir="ltr" class="font-semibold text-dark">@PanelLimits.Summary</span>
    رویداد اخیر محاسبه می‌شوند و با هر ری‌استارت سرویس صفر می‌شوند.
    فراخوانی که رد شود، فقط در لاگ درخواست‌ها می‌نشیند و پیام تولید نمی‌کند.
  </p>
</div>

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  @foreach (var card in cards)
  {
    <div class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
      <span class="@($"inline-flex rounded-full px-2.5 py-1 text-[11px] font-semibold {card.Tone}")">@card.Label</span>
      <p class="mt-3 text-2xl font-bold leading-none sm:text-3xl" dir="ltr">@card.Value</p>
      <p class="mt-2 text-[11px] leading-relaxed text-gray-400">@card.Hint</p>
    </div>
  }
</div>

<div class="mt-6 grid gap-4 lg:grid-cols-3">
  <section class="lg:col-span-2 rounded-2xl border border-gray-100 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3 sm:px-5">
      <h2 class="text-sm font-bold sm:text-base">آخرین پیام‌ها</h2>
      <a asp-controller="Messages" asp-action="Index"
        class="text-xs font-semibold text-primary transition-opacity hover:opacity-80 sm:text-sm">همهٔ پیام‌ها</a>
    </div>

    @if (Model.RecentMessages.Count == 0)
    {
      <p class="p-5 text-xs leading-relaxed text-body sm:text-sm">
        هنوز پیامی ثبت نشده است. یک <code dir="ltr">POST /api/v1/sms/send</code> با هدر
        <code dir="ltr">X-Sms-Api-Key</code> بزنید یا در سایت درخواست کد ورود دهید.
      </p>
    }
    else
    {
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs sm:text-sm">
          <thead class="bg-light text-[11px] text-body">
            <tr>
              <th class="px-4 py-2.5 font-semibold">گیرنده</th>
              <th class="px-4 py-2.5 font-semibold">متن</th>
              <th class="px-4 py-2.5 font-semibold">وضعیت</th>
              <th class="px-4 py-2.5 font-semibold">زمان (UTC)</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var message in Model.RecentMessages)
            {
              <tr class="border-t border-gray-100">
                <td class="whitespace-nowrap px-4 py-2.5 font-medium" dir="ltr">@message.Recipient</td>
                <td class="px-4 py-2.5 text-body">@PanelFormat.Preview(message.Message, 60)</td>
                <td class="px-4 py-2.5"><partial name="_Status" model="@message.Status" /></td>
                <td class="whitespace-nowrap px-4 py-2.5 text-gray-400" dir="ltr">@PanelFormat.UtcTime(message.CreatedAt)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </section>

  <section class="rounded-2xl border border-gray-100 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3 sm:px-5">
      <h2 class="text-sm font-bold sm:text-base">خطاهای اخیر</h2>
      <a asp-controller="Requests" asp-action="Index" asp-route-status="Failed"
        class="text-xs font-semibold text-primary transition-opacity hover:opacity-80 sm:text-sm">لاگ درخواست‌ها</a>
    </div>

    @if (Model.RecentFailures.Count == 0)
    {
      <p class="p-5 text-xs leading-relaxed text-body sm:text-sm">هیچ فراخوان ناموفقی در این بازه ثبت نشده است.</p>
    }
    else
    {
      <ul class="divide-y divide-gray-100">
        @foreach (var request in Model.RecentFailures)
        {
          <li class="p-4">
            <div class="flex items-center justify-between gap-2">
              <span dir="ltr" class="truncate text-xs font-semibold">
                @(request.Recipient ?? request.Endpoint)
              </span>
              <a asp-controller="Requests" asp-action="Details" asp-route-id="@request.RequestId"
                class="shrink-0 text-[11px] font-semibold text-primary hover:opacity-80">جزئیات</a>
            </div>
            <p class="mt-2 text-[11px] leading-relaxed text-body">
              <code dir="ltr" class="font-semibold text-danger">@request.ErrorCode</code>
              <span class="block text-gray-400">@request.ErrorMessage</span>
            </p>
          </li>
        }
      </ul>
    }
  </section>
</div>
