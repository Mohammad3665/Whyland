@model RequestListViewModel
@{
  ViewData["Title"] = "درخواست‌ها";

  var statusOptions = new[] { ("همه", ""), ("موفق", "Sent"), ("ناموفق", "Failed") };
}

<div class="mb-5">
  <h1 class="text-xl font-bold sm:text-2xl">لاگ درخواست‌های ورودی</h1>
  <p class="mt-1 text-xs leading-relaxed text-body sm:text-sm">
    هر فراخوانی که به <code dir="ltr">/api/v1/sms/*</code> می‌رسد اینجا ثبت می‌شود، از جمله درخواست‌هایی که
    به‌دلیل کلید نامعتبر، شمارهٔ اشتباه یا پارامتر جاافتاده رد شده‌اند. این جدول همان دادهٔ
    <code dir="ltr">GET /api/v1/sms/requests</code> است.
  </p>
</div>

<form method="get" asp-controller="Requests" asp-action="Index"
  class="mb-5 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <label for="recipient" class="mb-1.5 block text-xs font-semibold sm:text-sm">گیرنده</label>
      <input id="recipient" name="recipient" value="@Model.Recipient" dir="ltr" placeholder="0912"
        class="h-10 w-full rounded-xl border border-gray-200 bg-white px-3 text-right text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
    </div>
    <div>
      <label for="status" class="mb-1.5 block text-xs font-semibold sm:text-sm">وضعیت</label>
      <select id="status" name="status"
        class="h-10 w-full cursor-pointer rounded-xl border border-gray-200 bg-white px-3 text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm">
        @foreach (var (label, value) in statusOptions)
        {
          <option value="@value" selected="@(string.Equals(Model.Status, value, StringComparison.OrdinalIgnoreCase))">@label</option>
        }
      </select>
    </div>
    <div>
      <label for="limit" class="mb-1.5 block text-xs font-semibold sm:text-sm">تعداد ردیف</label>
      <input id="limit" name="limit" type="number" min="1" max="1000" value="@Model.Limit" dir="ltr"
        class="h-10 w-full rounded-xl border border-gray-200 bg-white px-3 text-right text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
    </div>
    <div class="flex items-end gap-2">
      <button type="submit"
        class="cursor-pointer rounded-full bg-dark px-4 py-2.5 text-xs font-semibold text-white transition-all hover:bg-dark/90 active:scale-[0.98] sm:text-sm">
        اعمال فیلتر
      </button>
      <a asp-controller="Requests" asp-action="Index"
        class="rounded-full border border-gray-200 px-4 py-2.5 text-xs font-semibold text-dark/70 transition-colors hover:border-gray-300 hover:text-dark sm:text-sm">
        پاک کردن
      </a>
    </div>
  </div>
</form>

<div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
  @if (Model.Requests.Count == 0)
  {
    <p class="p-6 text-xs leading-relaxed text-body sm:text-sm">فراخوانی با این فیلترها ثبت نشده است.</p>
  }
  else
  {
    <div class="overflow-x-auto">
      <table class="w-full text-right text-xs sm:text-sm">
        <thead class="bg-light text-[11px] text-body">
          <tr>
            <th class="px-4 py-3 font-semibold">مسیر</th>
            <th class="px-4 py-3 font-semibold">گیرنده</th>
            <th class="px-4 py-3 font-semibold">قالب</th>
            <th class="px-4 py-3 font-semibold">وضعیت</th>
            <th class="px-4 py-3 font-semibold">پیام / خطا</th>
            <th class="px-4 py-3 font-semibold">زمان (UTC)</th>
            <th class="px-4 py-3 font-semibold">جزئیات</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var request in Model.Requests)
          {
            <tr class="border-t border-gray-100 transition-colors hover:bg-light/60">
              <td class="whitespace-nowrap px-4 py-3 text-gray-400" dir="ltr">@request.Endpoint</td>
              <td class="whitespace-nowrap px-4 py-3 font-medium" dir="ltr">@(request.Recipient ?? "—")</td>
              <td class="whitespace-nowrap px-4 py-3" dir="ltr">@(request.TemplateCode ?? "—")</td>
              <td class="whitespace-nowrap px-4 py-3"><partial name="_Status" model="@request.Status" /></td>
              <td class="min-w-48 px-4 py-3">
                @if (string.IsNullOrWhiteSpace(request.ErrorCode))
                {
                  <code dir="ltr" class="text-[11px] text-success">@request.MessageId</code>
                }
                else
                {
                  <code dir="ltr" class="text-[11px] font-semibold text-danger">@request.ErrorCode</code>
                  <span class="block text-[11px] text-body">@PanelFormat.Preview(request.ErrorMessage, 70)</span>
                }
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-gray-400" dir="ltr">@PanelFormat.Utc(request.ReceivedAt)</td>
              <td class="whitespace-nowrap px-4 py-3">
                <a asp-controller="Requests" asp-action="Details" asp-route-id="@request.RequestId"
                  class="font-semibold text-primary transition-opacity hover:opacity-80">مشاهده</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
