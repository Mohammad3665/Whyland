@model SmsMessageRecord
@{
  ViewData["Title"] = "جزئیات پیام";
}

<div class="mb-5">
  <a asp-controller="Messages" asp-action="Index"
    class="inline-flex items-center gap-1 text-xs font-semibold text-body transition-colors hover:text-primary sm:text-sm">
    ← بازگشت به پیام‌ها
  </a>
  <h1 class="mt-2 text-xl font-bold sm:text-2xl">پیام <span dir="ltr" class="font-mono text-base">@Model.MessageId</span></h1>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
{
  <div class="mb-4 rounded-2xl border border-danger/20 bg-danger-light p-4 text-xs leading-relaxed sm:text-sm">
    <p class="font-semibold text-danger">
      <code dir="ltr">@Model.ErrorCode</code>
    </p>
    <p class="mt-1 text-body">@Model.ErrorMessage</p>
  </div>
}

<div class="grid gap-4 lg:grid-cols-3">
  <div class="lg:col-span-2 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <h2 class="mb-3 text-sm font-bold sm:text-base">متن نهایی ارسال‌شده</h2>
    <p class="whitespace-pre-wrap rounded-xl bg-light p-4 text-xs leading-loose text-dark sm:text-sm" dir="rtl">
      @Model.Message
    </p>
    <p class="mt-3 text-[11px] leading-relaxed text-gray-400">
      این متن پس از جای‌گذاری پارامترهای قالب تولید شده است. فراخوان‌هایی که رد شوند پیام نمی‌سازند و
      فقط در لاگ درخواست‌ها دیده می‌شوند.
    </p>
  </div>

  <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
    <h2 class="mb-3 text-sm font-bold sm:text-base">مشخصات</h2>
    <dl class="space-y-3 text-xs sm:text-sm">
      <div>
        <dt class="text-[11px] text-gray-400">گیرنده</dt>
        <dd class="font-medium" dir="ltr">@Model.Recipient</dd>
      </div>
      <div>
        <dt class="text-[11px] text-gray-400">وضعیت</dt>
        <dd><partial name="_Status" model="@Model.Status" /></dd>
      </div>
      <div>
        <dt class="text-[11px] text-gray-400">قالب</dt>
        <dd class="font-medium" dir="ltr">
          @(string.IsNullOrWhiteSpace(Model.TemplateCode)
              ? "بدون قالب (متن خام)"
              : Model.TemplateCode)
        </dd>
      </div>
      <div>
        <dt class="text-[11px] text-gray-400">ساخت رکورد (UTC)</dt>
        <dd dir="ltr">@PanelFormat.Utc(Model.CreatedAt)</dd>
      </div>
      <div>
        <dt class="text-[11px] text-gray-400">تحویل (UTC)</dt>
        <dd dir="ltr">@PanelFormat.UtcOrDash(Model.SentAt)</dd>
      </div>
    </dl>
  </div>
</div>
