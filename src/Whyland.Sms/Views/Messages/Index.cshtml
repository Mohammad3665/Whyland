@model MessageListViewModel
@{
  ViewData["Title"] = "پیام‌ها";

  // The simulator only ever stores Sent messages; a rejected call stays in the request log.
  var statusOptions = new[] { ("همه", ""), ("ارسال شده", "Sent"), ("در انتظار", "Pending"), ("ناموفق", "Failed") };
}

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-xl font-bold sm:text-2xl">پیام‌های ثبت‌شده</h1>
    <p class="mt-1 text-xs leading-relaxed text-body sm:text-sm">
      هر ردیف پیامی است که شبیه‌ساز پذیرفته است، همراه با متن نهایی. این جدول دقیقاً همان داده‌ای است که
      <code dir="ltr">GET /api/v1/sms/messages</code> برمی‌گرداند.
    </p>
  </div>
  <div class="flex items-center gap-2">
    <span id="live-state"
      class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1.5 text-[11px] font-semibold text-body"
      role="status" aria-live="polite">
      <span id="live-dot" class="inline-block h-2 w-2 rounded-full bg-gray-300"></span>
      <span id="live-text">در حال اتصال…</span>
    </span>
    <a asp-controller="Templates" asp-action="Create"
      class="cursor-pointer rounded-full bg-primary px-4 py-2.5 text-xs font-semibold text-white transition-all hover:bg-primary/90 active:scale-[0.98] sm:text-sm">
      قالب جدید
    </a>
  </div>
</div>

<form id="filter-form" method="get" asp-controller="Messages" asp-action="Index"
  class="mb-5 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <label for="recipient" class="mb-1.5 block text-xs font-semibold sm:text-sm">گیرنده</label>
      <input id="recipient" name="recipient" value="@Model.Recipient" dir="ltr" placeholder="912"
        class="h-10 w-full rounded-xl border border-gray-200 bg-white px-3 text-right text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
    </div>
    <div>
      <label for="status" class="mb-1.5 block text-xs font-semibold sm:text-sm">وضعیت</label>
      <select id="status" name="status"
        class="h-10 w-full cursor-pointer rounded-xl border border-gray-200 bg-white px-3 text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm">
        @foreach (var (label, value) in statusOptions)
        {
          <option value="@value" selected="@(string.Equals(Model.Status, value, StringComparison.OrdinalIgnoreCase))">@label</option>
        }
      </select>
    </div>
    <div>
      <label for="limit" class="mb-1.5 block text-xs font-semibold sm:text-sm">تعداد ردیف</label>
      <input id="limit" name="limit" type="number" min="1" max="1000" value="@Model.Limit" dir="ltr"
        class="h-10 w-full rounded-xl border border-gray-200 bg-white px-3 text-right text-xs outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary sm:text-sm" />
    </div>
    <div class="flex items-end gap-2">
      <button type="submit"
        class="cursor-pointer rounded-full bg-dark px-4 py-2.5 text-xs font-semibold text-white transition-all hover:bg-dark/90 active:scale-[0.98] sm:text-sm">
        اعمال فیلتر
      </button>
      <a asp-controller="Messages" asp-action="Index"
        class="rounded-full border border-gray-200 px-4 py-2.5 text-xs font-semibold text-dark/70 transition-colors hover:border-gray-300 hover:text-dark sm:text-sm">
        پاک کردن
      </a>
    </div>
  </div>
</form>

<div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
  <div class="overflow-x-auto">
    <table id="messages-table" class="w-full text-right text-xs sm:text-sm" data-limit="@Model.Limit">
      <thead class="bg-light text-[11px] text-body">
        <tr>
          <th class="px-4 py-3 font-semibold">گیرنده</th>
          <th class="px-4 py-3 font-semibold">متن پیام</th>
          <th class="px-4 py-3 font-semibold">قالب</th>
          <th class="px-4 py-3 font-semibold">وضعیت</th>
          <th class="px-4 py-3 font-semibold">زمان (UTC)</th>
          <th class="px-4 py-3 font-semibold">جزئیات</th>
        </tr>
      </thead>
        <tbody id="messages-body" data-live-messages="full" data-limit="@Model.Limit">
        @if (Model.Messages.Count == 0)
        {
          <tr id="messages-empty">
            <td colspan="6" class="p-6 text-xs leading-relaxed text-body sm:text-sm">
              پیامی با این فیلترها پیدا نشد. با ری‌استارت سرویس همهٔ پیام‌ها پاک می‌شوند.
            </td>
          </tr>
        }
        @foreach (var message in Model.Messages)
        {
          var badge = PanelStatus.BadgeOf(message.Status);
          <tr class="border-t border-gray-100 transition-colors hover:bg-light/60">
            <td class="whitespace-nowrap px-4 py-3 font-medium" dir="ltr">@message.Recipient</td>
            <td class="min-w-56 px-4 py-3 text-body">@PanelFormat.Preview(message.Message)</td>
            <td class="whitespace-nowrap px-4 py-3" dir="ltr">
              @(string.IsNullOrWhiteSpace(message.TemplateCode) ? "—" : message.TemplateCode)
            </td>
            <td class="whitespace-nowrap px-4 py-3">
              <span class="@badge.Tone inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold leading-none whitespace-nowrap">@badge.Label</span>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-gray-400" dir="ltr">@PanelFormat.Utc(message.CreatedAt)</td>
            <td class="whitespace-nowrap px-4 py-3">
              <a asp-controller="Messages" asp-action="Details" asp-route-id="@message.MessageId"
                class="font-semibold text-primary transition-opacity hover:opacity-80">مشاهده</a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
  <script src="~/panel/signalr.min.js"></script>
  <script src="~/panel/live-messages.js"></script>
}