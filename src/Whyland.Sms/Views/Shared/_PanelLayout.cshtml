@{
  var signedIn = User.Identity?.IsAuthenticated == true;
  var userName = User.Identity?.Name ?? "پنل";
  var activeController = ViewContext.RouteData.Values["controller"] as string;

  var navItems = new (string Label, string Controller)[]
  {
    ("داشبورد", "Dashboard"),
    ("پیام‌ها", "Messages"),
    ("درخواست‌ها", "Requests"),
    ("قالب‌ها", "Templates"),
  };
}
@functions {
  private static string NavClass(bool isActive) =>
    isActive
      ? "block rounded-full bg-primary/10 px-3 py-2 text-xs font-semibold text-primary sm:text-sm"
      : "block rounded-full px-3 py-2 text-xs font-medium text-body transition-colors hover:bg-white hover:text-primary sm:text-sm";
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] | پنل پیامک وایلند</title>

  <link rel="stylesheet" href="~/panel/style.css" asp-append-version="true" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&display=swap" rel="stylesheet" />

  @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-light font-['Vazirmatn'] text-dark antialiased">
  <header class="sticky top-0 z-40 border-b border-border bg-white/95 backdrop-blur-sm">
    <div class="container-whyland flex min-h-16 flex-wrap items-center justify-between gap-3 px-4 sm:min-h-20">
      <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-primary text-sm font-bold text-white">SMS</span>
        <span class="leading-tight">
          <span class="block text-sm font-bold sm:text-base">پنل شبیه‌ساز پیامک</span>
          <span class="block text-[11px] text-body">Whyland.Sms · v1</span>
        </span>
      </a>

      <nav class="order-3 w-full md:order-2 md:w-auto" aria-label="منوی پنل">
        @if (signedIn)
        {
          <ul class="flex flex-wrap items-center gap-1 md:gap-2">
            @foreach (var item in navItems)
            {
              var isActive = string.Equals(activeController, item.Controller, StringComparison.OrdinalIgnoreCase);
              <li>
                <a asp-controller="@item.Controller" asp-action="Index" class="@NavClass(isActive)">@item.Label</a>
              </li>
            }
          </ul>
        }
      </nav>

      <div class="order-2 flex items-center gap-2 md:order-3">
        @if (signedIn)
        {
          <span class="hidden text-xs text-body sm:inline">@userName</span>
          <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit"
              class="cursor-pointer rounded-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-dark/70 transition-all hover:border-gray-300 hover:text-dark active:scale-[0.98] sm:text-sm">
              خروج
            </button>
          </form>
        }
      </div>
    </div>
  </header>

  <main class="container-whyland px-4 py-6 sm:py-10">
    @RenderBody()
  </main>

  <footer class="container-whyland px-4 pb-10">
    <p class="rounded-2xl border border-gray-100 bg-white p-4 text-[11px] leading-relaxed text-body sm:text-xs">
      داده‌های این پنل در حافظهٔ فرآیند نگه‌داشته می‌شود: با هر بار ری‌استارت سرویس، پیام‌ها و درخواست‌ها پاک می‌شوند.
      فقط قالب‌ها در هر راه‌اندازی دوباره ساخته می‌شوند. «ارسال شد» یعنی شبیه‌ساز پیام را ثبت کرده است، نه اینکه
      اپراتور آن را تحویل داده باشد.
    </p>
  </footer>

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
