												var item = breadcrumbs[i];

												<!--اسلش فقط قبل از آیتم‌های دوم به بعد-->
												@if (i > 0)
												{
													<li class="breadcrumb-item">
														<span class="text-muted">/</span>
													</li>
												}

												<li class="breadcrumb-item @(item.IsActive ? "text-gray-700" : "text-muted")">
													@if (!string.IsNullOrEmpty(item.Url))
													{
														<a asp-page="@item.Url" class="text-muted text-hover-primary">@item.Title</a>
													}
													else
													{
														<span>@item.Title</span>
													}
												</li>
											}
										}
										else
										{
