@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.EpisodeAttachments.IndexModel
@{
    ViewData["Title"] = "پیوست‌های اپیزود";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = "/Courses/Index", IsActive = false },
        new BreadcrumbItem { Title = "سرفصل‌های دوره", Url = "/CourseSections/Index", IsActive = false },
        new BreadcrumbItem { Title = "اپیزودها", Url = "/Episodes/Index", IsActive = false },
        new BreadcrumbItem { Title = "پیوست‌ها", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت پیوست‌های اپیزود
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                دوره: <span class="text-gray-800">@Model.CourseTitle</span>
                <span class="mx-1">|</span>
                سرفصل: <span class="text-gray-800">@Model.SectionTitle</span>
                <span class="mx-1">|</span>
                اپیزود: <span class="text-gray-800">@Model.EpisodeTitle</span>
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/Episodes/Index?sectionId=@Model.SectionId&courseId=@Model.CourseId" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به اپیزودها
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_attachment"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-paper-clip fs-4 me-1"></i>
                افزودن پیوست جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="attachmentSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در پیوست‌ها..." />
                </div>
                <!--end::Search-->

                <!--begin::Limits hint-->
                <div class="d-flex align-items-center text-muted fs-7">
                    <i class="ki-duotone ki-information-4 fs-4 text-gray-500 me-1">
                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    </i>
                    حداکثر <span class="fw-bold text-gray-800 mx-1">@Model.MaxAttachmentsPerEpisode</span>
                    پیوست، هر کدام حداکثر
                    <span class="fw-bold text-gray-800 mx-1">@Model.MaxAttachmentSizeDisplay</span>
                </div>
                <!--end::Limits hint-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_episode_attachments_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-start">نام فایل</th>
                            <th class="text-start">نوع فایل</th>
                            <th class="text-start w-150px">حجم</th>
                            <th class="text-start w-200px">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Demo rows — replace with real data when the data layer is wired up. -->
                        <tr data-id="1">
                            <td class="dtr-control-col"></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-file-down fs-2x text-primary me-3">
                                        <span class="path1"></span><span class="path2"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold" dir="ltr">aspnet-core-setup-guide.pdf</span>
                                </div>
                            </td>
                            <td><span class="badge badge-light-primary" dir="ltr">application/pdf</span></td>
                            <td data-order="245760">
                                <span class="text-gray-600" dir="ltr">240 KB</span>
                            </td>
                            <td data-order="2026-10-01">
                                <span class="text-gray-600">۱۴۰۵/۰۷/۰۹</span>
                            </td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'aspnet-core-setup-guide.pdf')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="2">
                            <td class="dtr-control-col"></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-file-down fs-2x text-success me-3">
                                        <span class="path1"></span><span class="path2"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold" dir="ltr">project-samples.zip</span>
                                </div>
                            </td>
                            <td><span class="badge badge-light-success" dir="ltr">application/zip</span></td>
                            <td data-order="5242880">
                                <span class="text-gray-600" dir="ltr">5 MB</span>
                            </td>
                            <td data-order="2026-10-02">
                                <span class="text-gray-600">۱۴۰۵/۰۷/۱۰</span>
                            </td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'project-samples.zip')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="3">
                            <td class="dtr-control-col"></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-file-down fs-2x text-info me-3">
                                        <span class="path1"></span><span class="path2"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold" dir="ltr">slides-01-intro.pptx</span>
                                </div>
                            </td>
                            <td><span class="badge badge-light-info" dir="ltr">application/vnd.ms-powerpoint</span></td>
                            <td data-order="1048576">
                                <span class="text-gray-600" dir="ltr">1 MB</span>
                            </td>
                            <td data-order="2026-10-03">
                                <span class="text-gray-600">۱۴۰۵/۰۷/۱۱</span>
                            </td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'slides-01-intro.pptx')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_EpisodeAttachmentModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/episode-attachments.js"></script>
}
