@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.CourseFaqs.IndexModel
@{
    ViewData["Title"] = "سوالات متداول دوره";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = "/Courses/Index", IsActive = false },
        new BreadcrumbItem { Title = "سوالات متداول", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت سوالات متداول دوره
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                دوره: <span class="text-gray-800">@Model.CourseTitle</span>
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/Courses/Index" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به دوره‌ها
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_course_faq"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن سوال جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="courseFaqSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در سوالات..." />
                </div>
                <!--end::Search-->

                <!--begin::Hint-->
                <div class="d-flex align-items-center text-muted fs-7">
                    <i class="ki-duotone ki-arrows-move fs-4 text-gray-500 me-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    برای تغییر ترتیب، سطرها را از ستون «ترتیب» درگ کنید
                </div>
                <!--end::Hint-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_course_faqs_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-400px">عنوان سوال</th>
                            <th class="text-start actions-cell">توضیحات</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Demo rows — replace with real data when the data layer is wired up. -->
                        <tr data-id="1">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="course-faq-order badge badge-light-secondary">1</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">پیش‌نیازهای این دوره چیست؟</span></td>
                            <td><span class="text-gray-600">آشنایی مقدماتی با برنامه‌نویسی کافی است؛ هیچ پیش‌نیاز خاصی لازم نیست.</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(1, 'پیش‌نیازهای این دوره چیست؟', 'آشنایی مقدماتی با برنامه‌نویسی کافی است؛ هیچ پیش‌نیاز خاصی لازم نیست.', 1)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'پیش‌نیازهای این دوره چیست؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="2">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="course-faq-order badge badge-light-secondary">2</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">آیا پس از خرید می‌توانم به محتوای دوره دسترسی دائمی داشته باشم؟</span></td>
                            <td><span class="text-gray-600">بله، دسترسی به محتوای دوره دائمی است و محدودیت زمانی ندارد.</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(2, 'آیا پس از خرید می‌توانم به محتوای دوره دسترسی دائمی داشته باشم؟', 'بله، دسترسی به محتوای دوره دائمی است و محدودیت زمانی ندارد.', 2)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'آیا پس از خرید می‌توانم به محتوای دوره دسترسی دائمی داشته باشم؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="3">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="course-faq-order badge badge-light-secondary">3</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">آیا گواهی پایان دوره ارائه می‌شود؟</span></td>
                            <td><span class="text-gray-600">بله، پس از تکمیل تمام اپیزودها گواهی پایان دوره صادر می‌شود.</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(3, 'آیا گواهی پایان دوره ارائه می‌شود؟', 'بله، پس از تکمیل تمام اپیزودها گواهی پایان دوره صادر می‌شود.', 3)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'آیا گواهی پایان دوره ارائه می‌شود؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_CourseFaqModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/course-faqs.js"></script>
}
