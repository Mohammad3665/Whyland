@page "{userId:int?}"
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.InstructorProfile.IndexModel
@{
    ViewData["Title"] = "پروفایل مدرس";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "کاربران", Url = "/Users/Index", IsActive = false },
        new BreadcrumbItem { Title = "پروفایل مدرس", Url = null, IsActive = true }
    };
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                پروفایل مدرس
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                اطلاعات عمومی و مالی مدرس: <span class="text-gray-800 fw-bold">@Model.InstructorName</span>
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/Users/Index" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به لیست کاربران
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openEditModal()">
                <i class="ki-duotone ki-pencil fs-4 me-1"></i>
                ویرایش پروفایل
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Row: identity card + info cards (view-only)-->
        <div class="row g-6 g-xl-9">

            <!--begin::Col: identity card-->
            <div class="col-xl-4">
                <div class="card card-flush">
                    <!--begin::Card body-->
                    <div class="card-body d-flex flex-column align-items-center text-center py-10">
                        <div class="symbol symbol-150px symbol-circle mb-6 overflow-hidden">
                            <img id="View_ProfileImage" src="~/assets/media/avatars/300-1.jpg" alt="تصویر مدرس"
                                 style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%; background: var(--bs-body-bg);"
                                 onerror="this.onerror=null;this.src='/assets/media/avatars/blank.png';" />
                            <span class="symbol-badge badge badge-light-primary start-100 translate-middle mt-n2">
                                مدرس
                            </span>
                        </div>

                        <div class="text-gray-800 fw-bold fs-4 mb-1">@Model.InstructorName</div>
                        <div class="text-muted fs-7 mb-8" id="View_Specialization_inline">
                            توسعه‌دهنده بک‌اند و مدرس وب
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="#" class="btn btn-sm btn-light" id="View_WebsiteLink" target="_blank" rel="noopener">
                                <i class="fas fa-globe fs-4 me-1"></i>
                                وب‌سایت
                            </a>
                            <a href="#" class="btn btn-sm btn-light" id="View_LinkedInLink" target="_blank" rel="noopener">
                                <i class="fab fa-linkedin-in fs-4 me-1"></i>
                                لینکدین
                            </a>
                            <a href="#" class="btn btn-sm btn-light" id="View_InstagramLink" target="_blank" rel="noopener">
                                <i class="fab fa-instagram fs-4 me-1"></i>
                                اینستاگرام
                            </a>
                        </div>
                    </div>
                    <!--end::Card body-->
                </div>
            </div>
            <!--end::Col-->

            <!--begin::Col: info cards-->
            <div class="col-xl-8">
                <div class="d-flex flex-column gap-6 gap-xl-9">

                    <!--begin::Card: biographies-->
                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title">
                                <h2 class="fw-bold text-gray-900">بیوگرافی</h2>
                            </div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="mb-8">
                                <div class="fs-7 fw-semibold text-muted mb-2">بیوگرافی کوتاه</div>
                                <div class="text-gray-800 fs-6" id="View_Bio">
                                    مدرس دوره‌های توسعه وب با بیش از ۸ سال تجربه برنامه‌نویسی و تدریس
                                </div>
                            </div>
                            <div>
                                <div class="fs-7 fw-semibold text-muted mb-2">بیوگرافی کامل</div>
                                <div class="text-gray-800 fs-6 lh-lg" id="View_Biography">
                                    علی محمدی، توسعه‌دهنده ارشد بک‌اند و مدرس دوره‌های تخصصی وب. او در طول این سال‌ها علاوه بر توسعه محصولات واقعی، به آموزش و منتورینگ برنامه‌نویسان نیز پرداخته است.
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Card-->

                    <!--begin::Card: specialization & social-->
                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title">
                                <h2 class="fw-bold text-gray-900">تخصص و شبکه‌های اجتماعی</h2>
                            </div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="row g-6">
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">تخصص</div>
                                    <div class="text-gray-800 fs-6" id="View_Specialization">
                                        توسعه‌دهنده بک‌اند و مدرس وب
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">وب‌سایت</div>
                                    <div class="fs-6" id="View_Website">
                                        <a href="#" class="text-gray-800 text-hover-primary">https://alimohammadi.dev</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">لینکدین</div>
                                    <div class="fs-6 text-gray-800" id="View_LinkedIn">
                                        <a href="#" class="text-gray-800 text-hover-primary">linkedin.com/in/ali-mohammadi</a>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">اینستاگرام</div>
                                    <div class="fs-6 text-gray-800" id="View_Instagram">
                                        <a href="#" class="text-gray-800 text-hover-primary">instagram.com/ali.codes</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Card-->

                    <!--begin::Card: address & bank-->
                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title">
                                <h2 class="fw-bold text-gray-900">آدرس و اطلاعات مالی</h2>
                            </div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="mb-8">
                                <div class="fs-7 fw-semibold text-muted mb-2">آدرس</div>
                                <div class="text-gray-800 fs-6" id="View_Address">
                                    تهران، خیابان آزادی، کوچه بهار، پلاک ۱۲، واحد ۳
                                </div>
                            </div>

                            <div class="row g-6">
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">شماره شبا</div>
                                    <div class="d-flex flex-nowrap align-items-center">
                                        <div class="fs-6 text-gray-800 text-nowrap flex-grow-1 text-truncate" dir="ltr" id="View_ShebaNumber"
                                             title="IR6104 3371 2345 6789 0123 4567">
                                            IR6104 3371 2345 6789 0123 4567
                                        </div>
                                        <button type="button" class="btn btn-sm btn-icon btn-active-color-primary flex-shrink-0 ms-2"
                                                title="کپی شماره شبا" onclick="copyToClipboard('View_ShebaNumber', this)">
                                            <i class="ki-duotone ki-copy fs-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">شماره حساب</div>
                                    <div class="d-flex flex-nowrap align-items-center">
                                        <div class="fs-6 text-gray-800 text-nowrap flex-grow-1 text-truncate" dir="ltr" id="View_BankAccountNumber"
                                             title="7123 4567 8946 7843">
                                            7123 4567 8946 7843
                                        </div>
                                        <button type="button" class="btn btn-sm btn-icon btn-active-color-primary flex-shrink-0 ms-2"
                                                title="کپی شماره حساب" onclick="copyToClipboard('View_BankAccountNumber', this)">
                                            <i class="ki-duotone ki-copy fs-3"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Card-->
                </div>
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
</div>
<!--end::Content-->

<partial name="_InstructorProfileModals" />

@section Scripts {
    <script src="~/js/instructor-profile.js"></script>
}
