
<!--begin::Details Modal-->
<div class="modal fade" id="kt_modal_faq_details" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin::Heading-->
                <div class="mb-13 text-center">
                    <h1 class="mb-3">جزئیات سوال متداول</h1>
                    <div class="text-muted fw-semibold fs-5">مشاهده کامل سوال و پاسخ</div>
                </div>
                <!--end::Heading-->

                <!--begin::Question-->
                <div class="mb-8">
                    <label class="fs-6 fw-semibold text-gray-800 mb-2">عنوان سوال</label>
                    <div class="fs-5 fw-bold text-gray-900" id="details-faq-title"></div>
                </div>
                <!--end::Question-->

                <!--begin::Answer-->
                <div>
                    <label class="fs-6 fw-semibold text-gray-800 mb-2">پاسخ</label>
                    <div class="fs-6 text-gray-700 lh-lg" id="details-faq-description"
                         style="white-space: pre-line; word-break: break-word"></div>
                </div>
                <!--end::Answer-->

                <!--begin::Actions-->
                <div class="d-flex justify-content-end mt-10">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">بستن</button>
                </div>
                <!--end::Actions-->
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>
<!--end::Details Modal-->

<!--begin::Create/Edit Modal-->
<div class="modal fade" id="kt_modal_faq" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <form id="kt_modal_faq_form" class="form" onsubmit="return false;">
                    <!--begin::Heading-->
                    <div class="mb-13 text-center">
                        <h1 class="mb-3" id="modal-faq-title">افزودن سوال متداول</h1>
                        <div class="text-muted fw-semibold fs-5">
                            سوال و پاسخ آن را وارد کنید
                        </div>
                    </div>
                    <!--end::Heading-->

                    <!--begin::Input group - Title-->
                    <div class="fv-row mb-8">
                        <label class="required fs-6 fw-semibold mb-2">عنوان سوال</label>
                        <input type="text" id="Form_Title" name="Form_Title"
                               class="form-control form-control-solid"
                               maxlength="300"
                               placeholder="مثال: چگونه می‌توانم ثبت‌نام کنم؟" />
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group - Description-->
                    <div class="fv-row mb-8">
                        <label class="required fs-6 fw-semibold mb-2">پاسخ (توضیحات)</label>
                        <textarea id="Form_Description" name="Form_Description"
                                  class="form-control form-control-solid" rows="4"
                                  maxlength="2000" placeholder="پاسخ کامل سوال را بنویسید..."></textarea>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group - DisplayOrder & IsActive-->
                    <div class="row g-9 mb-8">
                        <div class="col-md-6 fv-row">
                            <label class="fs-6 fw-semibold mb-2">ترتیب نمایش</label>
                            <input type="number" id="Form_DisplayOrder" name="Form_DisplayOrder"
                                   class="form-control form-control-solid" value="1" />
                            <div class="text-muted fs-7 mt-1">
                                ترتیب سوالات همچنین با درگ کردن سطرها در جدول قابل تغییر است
                            </div>
                        </div>
                        <div class="col-md-6 fv-row">
                            <div class="d-flex flex-stack h-100 justify-content-end pb-4">
                                <div class="me-5">
                                    <label class="fs-6 fw-semibold">وضعیت فعال</label>
                                    <div class="text-muted fs-7">سوال غیرفعال در سایت نمایش داده نمی‌شود</div>
                                </div>
                                <label class="form-check form-switch form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" id="Form_IsActive" checked />
                                    <span class="form-check-label fw-semibold text-muted">فعال</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Actions-->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-primary" id="kt_modal_faq_submit"
                                onclick="submitFaqForm()">
                            <span class="indicator-label">ذخیره</span>
                            <span class="indicator-progress">
                                لطفاً صبر کنید...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>

<!--end::Create/Edit Modal-->

<!--begin::Delete Confirmation Modal-->
<div class="modal fade" id="kt_modal_delete_faq" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body text-center pt-0 pb-15 px-10">
                <i class="ki-duotone ki-trash fs-5x text-danger mb-5">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    <span class="path4"></span><span class="path5"></span>
                </i>

                <h2 class="mb-3">حذف سوال متداول</h2>

                <div class="text-muted fw-semibold fs-5 mb-8">
                    آیا از حذف سوال
                    <span class="fw-bold text-gray-900" id="delete-faq-name"></span>
                    مطمئن هستید؟
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <span class="indicator-label">بله، حذف شود</span>
                        <span class="indicator-progress">
                            لطفاً صبر کنید...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>
<!--end::Delete Confirmation Modal-->
