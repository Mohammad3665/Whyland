@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.SiteSettings.Seo.IndexModel
@{
    ViewData["Title"] = "تنظیمات سئو";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "تنظیمات", Url = null, IsActive = false },
        new BreadcrumbItem { Title = "تنظیمات سئو", Url = null, IsActive = true }
    };
}

<!--begin::Settings page (read-only view + edit modal)-->

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                تنظیمات سئو
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                متا تایتل، متا دیسکریپشن، کلمات کلیدی و Open Graph
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_settings_edit"
                    onclick="openSettingsModal()">
                <i class="ki-duotone ki-pencil fs-4 me-1"><span class="path1"></span><span class="path2"></span></i>
                ویرایش تنظیمات
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush" id="kt_settings_page" data-settings-group="seo">
            <!--begin::Card header-->
            <div class="card-header pt-7">
                <div class="card-title">
                    <div class="d-flex flex-column">
                        <h2 class="fw-bold text-gray-900 mb-1">مقادیر فعلی</h2>
                        <span class="text-muted fw-semibold fs-7">
                            این مقادیر به عنوان پیش‌فرض متادیتای صفحاتی که مقدار اختصاصی ندارند استفاده می‌شوند
                        </span>
                    </div>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-5">
                <div class="row g-6 g-xl-9">

                    <!--begin::Item - Meta title-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">عنوان متا پیش‌فرض</div>
                        <div class="text-gray-800 fs-6 fw-bold" id="View_MetaTitle"
                             data-value="آکادمی وایلند | آموزش آنلاین برنامه‌نویسی">آکادمی وایلند | آموزش آنلاین برنامه‌نویسی</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - OG image-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">تصویر Open Graph</div>
                        <div class="d-flex align-items-center justify-content-center bg-white border border-gray-300 border-dashed rounded p-2"
                             style="width: 240px; height: 125px;">
                            <img id="View_OgImage" data-value="/assets/media/stock/900x600/1.jpg"
                                 src="/assets/media/stock/900x600/1.jpg" alt="تصویر Open Graph"
                                 class="mw-100 mh-100 object-fit-contain"
                                 onerror="this.onerror=null;this.src='/assets/media/svg/files/blank-image.svg';" />
                        </div>
                        <div class="text-muted fs-7 mt-1">تصویر پیش‌فرض اشتراک‌گذاری در شبکه‌های اجتماعی</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Meta description-->
                    <div class="col-12">
                        <div class="fs-7 fw-semibold text-muted mb-2">توضیحات متا پیش‌فرض</div>
                        <div class="text-gray-800 fs-6 lh-lg" id="View_MetaDescription"
                             data-value="دوره‌های تخصصی برنامه‌نویسی، طراحی و مهارت‌های دیجیتال را با تدریس اساتید باتجربه به صورت آنلاین در آکادمی وایلند یاد بگیرید.">
                            دوره‌های تخصصی برنامه‌نویسی، طراحی و مهارت‌های دیجیتال را با تدریس اساتید باتجربه به صورت آنلاین در آکادمی وایلند یاد بگیرید.
                        </div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Meta keywords-->
                    <div class="col-12">
                        <div class="fs-7 fw-semibold text-muted mb-2">کلمات کلیدی پیش‌فرض</div>
                        <div class="text-gray-800 fs-6" id="View_MetaKeywords"
                             data-value="آموزش آنلاین, برنامه نویسی, طراحی وب, وایلند">آموزش آنلاین, برنامه نویسی, طراحی وب, وایلند</div>
                    </div>
                    <!--end::Item-->
                </div>
            </div>
            <!--end::Card body-->

            <!--begin::Card footer-->
            <div class="card-footer pt-5">
                <div class="text-muted fs-7">
                    آخرین بروزرسانی:
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedText</span>
                    توسط
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedBy</span>
                </div>
            </div>
            <!--end::Card footer-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_SeoModals" />

@section Scripts {
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/site-settings.js"></script>
}
