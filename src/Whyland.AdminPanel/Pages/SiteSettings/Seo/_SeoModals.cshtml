<!--begin::Edit Settings Modal (تنظیمات سئو - section 12.2)-->
<div class="modal fade" id="kt_modal_settings_edit" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <form id="kt_modal_settings_form" class="form" onsubmit="return false;">
                    <!--begin::Heading-->
                    <div class="mb-13 text-center">
                        <h1 class="mb-3">ویرایش تنظیمات سئو</h1>
                        <div class="text-muted fw-semibold fs-5">
                            مقادیر پیش‌فرض متادیتای صفحات وب‌سایت
                        </div>
                    </div>
                    <!--end::Heading-->

                    <!--begin::Input group - Meta title-->
                    <div class="fv-row mb-8">
                        <label class="fs-6 fw-semibold mb-2">عنوان متا پیش‌فرض</label>
                        <input type="text" id="Form_MetaTitle" name="Form_MetaTitle"
                               class="form-control form-control-solid"
                               maxlength="200"
                               placeholder="مثال: آکادمی وایلند | آموزش آنلاین" />
                        <div class="text-muted fs-7 mt-1">حداکثر ۲۰۰ کاراکتر — در تب مرورگر و نتایج جستجو نمایش داده می‌شود</div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group - Meta description-->
                    <div class="fv-row mb-8">
                        <label class="fs-6 fw-semibold mb-2">توضیحات متا پیش‌فرض</label>
                        <textarea id="Form_MetaDescription" name="Form_MetaDescription"
                                  class="form-control form-control-solid" rows="3"
                                  maxlength="500"
                                  placeholder="توضیحات پیش‌فرض صفحات برای موتورهای جستجو..."></textarea>
                        <div class="text-muted fs-7 mt-1">حداکثر ۵۰۰ کاراکتر</div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group - Meta keywords-->
                    <div class="fv-row mb-8">
                        <label class="fs-6 fw-semibold mb-2">کلمات کلیدی پیش‌فرض</label>
                        <input type="text" id="Form_MetaKeywords" name="Form_MetaKeywords"
                               class="form-control form-control-solid" dir="ltr"
                               placeholder="education, online-courses, elearning" />
                        <div class="text-muted fs-7 mt-1">کلمات با کاما جدا شوند</div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group - OG image-->
                    <div class="fv-row mb-8">
                        <label class="fs-6 fw-semibold mb-2">تصویر Open Graph</label>
                        <div class="d-flex align-items-start gap-5">
                            <div class="d-flex align-items-center justify-content-center bg-white border border-gray-300 border-dashed rounded p-2"
                                 style="width: 240px; height: 125px;">
                                <img id="Form_OgImage_preview" src="/assets/media/stock/900x600/1.jpg" alt=""
                                     class="mw-100 mh-100 object-fit-contain"
                                     onerror="this.onerror=null;this.src='/assets/media/svg/files/blank-image.svg';" />
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <label class="btn btn-sm btn-light-primary" for="Form_OgImageFile">
                                    <i class="ki-duotone ki-picture fs-4 me-1"><span class="path1"></span><span class="path2"></span></i>
                                    انتخاب تصویر
                                </label>
                                <input type="file" id="Form_OgImageFile" class="d-none"
                                       accept=".png,.jpg,.jpeg,.webp"
                                       onchange="previewSettingsImage(this, 'OgImage')" />
                                <button type="button" class="btn btn-sm btn-light-danger"
                                        onclick="clearSettingsImage('OgImage')">
                                    حذف تصویر
                                </button>
                            </div>
                        </div>
                        <div class="text-muted fs-7 mt-2">
                            فرمت‌های مجاز: PNG، JPG یا WebP — حداکثر ۲ مگابایت
                        </div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Actions-->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-primary" id="kt_settings_submit"
                                onclick="saveSettings()">
                            <span class="indicator-label">ذخیره</span>
                            <span class="indicator-progress">
                                لطفاً صبر کنید...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>
<!--end::Edit Settings Modal-->
