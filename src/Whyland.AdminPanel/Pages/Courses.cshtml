@page
@using Whyland.AdminPanel.Models
@{
    ViewData["Title"] = "دوره‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <style>
        /* دیالوگ‌ها و منوهای TinyMCE باید بالاتر از مودال تمام‌صفحه باشند */
        .tox-tinymce-aux,
        .tox .tox-dialog-wrap,
        .tox .tox-silver-sink { z-index: 2000 !important; }
        .tox-tinymce { border-radius: .475rem !important; border-color: var(--bs-gray-300, #dbdfe9) !important; }
    </style>
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت دوره‌ها
            </h1>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن دوره جدید
            </button>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="courseSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در دوره‌ها..." />
                </div>
                <!--end::Search-->

                <!--begin::Filters-->
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <select id="statusFilter" class="form-select form-select-solid w-150px">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="draft">پیش‌نویس</option>
                        <option value="published">منتشر شده</option>
                        <option value="hidden">مخفی</option>
                    </select>
                    <select id="categoryFilter" class="form-select form-select-solid w-175px">
                        <option value="">همه دسته‌بندی‌ها</option>
                        <option value="1">برنامه‌نویسی</option>
                        <option value="2">برنامه‌نویسی وب</option>
                        <option value="3">ASP.NET Core</option>
                        <option value="5">طراحی گرافیک</option>
                        <option value="6">کسب و کار</option>
                    </select>
                    <select id="instructorFilter" class="form-select form-select-solid w-175px">
                        <option value="">همه مدرسین</option>
                        <option value="1">علی رضایی</option>
                        <option value="2">مریم احمدی</option>
                        <option value="3">سارا کریمی</option>
                    </select>
                </div>
                <!--end::Filters-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_courses_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-start">تصویر</th>
                            <th class="text-start">نام</th>
                            <th class="text-start">نام لاتین</th>
                            <th class="text-start">قیمت</th>
                            <th class="text-start">وضعیت نمایش</th>
                            <th class="text-start">ویژه</th>
                            <th class="text-start">شگفت‌انگیز</th>
                            <th class="text-start">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-status="published" data-categories="1,2,3" data-instructors="1">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/assets/media/stock/600x400/img-1.jpg" alt="ASP.NET Core" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">دوره جامع ASP.NET Core</span></td>
                            <td><span class="text-gray-600">Complete ASP.NET Core</span></td>
                            <td data-order="1500000"><span class="text-gray-800 fw-bold">1,500,000</span> <span class="text-muted fs-7">تومان</span></td>
                            <td><span class="badge badge-light-success">منتشر شده</span></td>
                            <td><span class="badge badge-light-warning">ویژه</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/12</span></td>
                            <td class="text-end">
                                <a href="/CourseChapters/1" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1" title="مدیریت سرفصل‌ها">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(1)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'دوره جامع ASP.NET Core')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="published" data-categories="1,2" data-instructors="2">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/assets/media/stock/600x400/img-2.jpg" alt="JavaScript" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">آموزش مقدماتی جاوااسکریپت</span></td>
                            <td><span class="text-gray-600">JavaScript Basics</span></td>
                            <td data-order="0"><span class="badge badge-light-primary">رایگان</span></td>
                            <td><span class="badge badge-light-success">منتشر شده</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="badge badge-light-danger">شگفت‌انگیز</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/14</span></td>
                            <td class="text-end">
                                <a href="/CourseChapters/2" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1" title="مدیریت سرفصل‌ها">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(2)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'آموزش مقدماتی جاوااسکریپت')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="draft" data-categories="5" data-instructors="3">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/assets/media/svg/files/blank-image.svg" alt="Photoshop" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">فتوشاپ از صفر تا صد</span></td>
                            <td><span class="text-gray-600">Photoshop A to Z</span></td>
                            <td data-order="850000"><span class="text-gray-800 fw-bold">850,000</span> <span class="text-muted fs-7">تومان</span></td>
                            <td><span class="badge badge-light-secondary">پیش‌نویس</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/15</span></td>
                            <td class="text-end">
                                <a href="/CourseChapters/3" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1" title="مدیریت سرفصل‌ها">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(3)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'فتوشاپ از صفر تا صد')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="hidden" data-categories="6" data-instructors="1,3">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/assets/media/stock/600x400/img-3.jpg" alt="Business" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">کارآفرینی و استارتاپ</span></td>
                            <td><span class="text-gray-600">Entrepreneurship</span></td>
                            <td data-order="2400000"><span class="text-gray-800 fw-bold">2,400,000</span> <span class="text-muted fs-7">تومان</span></td>
                            <td><span class="badge badge-light-dark">مخفی</span></td>
                            <td><span class="badge badge-light-warning">ویژه</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/18</span></td>
                            <td class="text-end">
                                <a href="/CourseChapters/4" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1" title="مدیریت سرفصل‌ها">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(4)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(4, 'کارآفرینی و استارتاپ')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
    </div>
</div>
<!--end::Content-->

<!-- ==================== مودال تمام‌صفحه ایجاد/ویرایش ==================== -->
<div class="modal fade" id="kt_modal_course" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header">
                <h2 class="fw-bold mb-0" id="modal-course-title">افزودن دوره جدید</h2>
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body bg-light px-5 px-lg-10 py-7">
                <form id="kt_course_form" class="form d-flex flex-column flex-lg-row gap-7 gap-lg-10" onsubmit="return false;">
                    <input type="hidden" id="Form_Id" />

                    <!-- ============ ستون کناری ============ -->
                    <div class="d-flex flex-column gap-7 gap-lg-10 w-100 w-lg-350px">

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>تصویر اصلی</h2></div></div>
                            <div class="card-body text-center pt-0">
                                <div class="image-input image-input-outline image-input-empty mb-3" id="Form_MainImage_wrapper"
                                     data-kt-image-input="true" style="background-image: url('/assets/media/svg/files/blank-image.svg')">
                                    <div class="image-input-wrapper w-200px h-150px"></div>
                                    <label class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                                           data-kt-image-input-action="change" title="تغییر تصویر">
                                        <i class="ki-duotone ki-pencil fs-6"><span class="path1"></span><span class="path2"></span></i>
                                        <input type="file" id="Form_MainImage" name="MainImage" accept=".png,.jpg,.jpeg,.webp" />
                                        <input type="hidden" name="MainImage_remove" />
                                    </label>
                                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                                          data-kt-image-input-action="cancel" title="انصراف">
                                        <i class="ki-duotone ki-cross fs-2"><span class="path1"></span><span class="path2"></span></i>
                                    </span>
                                    <span class="btn btn-icon btn-circle btn-color-muted btn-active-color-primary w-25px h-25px bg-body shadow"
                                          data-kt-image-input-action="remove" title="حذف تصویر">
                                        <i class="ki-duotone ki-cross fs-2"><span class="path1"></span><span class="path2"></span></i>
                                    </span>
                                </div>
                                <div class="text-muted fs-7">فرمت‌های مجاز: png، jpg، jpeg، webp</div>
                            </div>
                        </div>

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>وضعیت</h2></div></div>
                            <div class="card-body pt-0">
                                <label class="fs-6 fw-semibold mb-2">وضعیت نمایش</label>
                                <select id="Form_DisplayStatus" class="form-select form-select-solid mb-8">
                                    <option value="Draft">پیش‌نویس</option>
                                    <option value="Published">منتشر شده</option>
                                    <option value="Hidden">مخفی</option>
                                </select>

                                <div class="d-flex flex-stack mb-6">
                                    <div class="me-5">
                                        <label class="fs-6 fw-semibold">دوره ویژه</label>
                                        <div class="text-muted fs-7">نمایش در بخش دوره‌های ویژه</div>
                                    </div>
                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" id="Form_IsFeatured" />
                                    </label>
                                </div>

                                <div class="d-flex flex-stack">
                                    <div class="me-5">
                                        <label class="fs-6 fw-semibold">شگفت‌انگیز</label>
                                        <div class="text-muted fs-7">نمایش در بخش پیشنهادهای شگفت‌انگیز</div>
                                    </div>
                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" id="Form_IsAmazing" />
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>دسته‌بندی‌ها</h2></div></div>
                            <div class="card-body pt-0">
                                <select id="Form_CategoryIds" class="form-select form-select-solid" data-control="select2"
                                        data-dropdown-parent="#kt_modal_course" data-placeholder="انتخاب دسته‌بندی‌ها" multiple>
                                    <option value="1">برنامه‌نویسی</option>
                                    <option value="2">— برنامه‌نویسی وب</option>
                                    <option value="3">—— ASP.NET Core</option>
                                    <option value="5">طراحی گرافیک</option>
                                    <option value="6">کسب و کار</option>
                                    <option value="7">زبان‌های خارجی</option>
                                </select>
                                <div class="text-muted fs-7 mt-2">فقط دسته‌بندی‌های فعال نمایش داده می‌شوند</div>
                            </div>
                        </div>

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>مدرسین</h2></div></div>
                            <div class="card-body pt-0">
                                <select id="Form_InstructorIds" class="form-select form-select-solid" data-control="select2"
                                        data-dropdown-parent="#kt_modal_course" data-placeholder="انتخاب مدرسین" multiple>
                                    <option value="1">علی رضایی</option>
                                    <option value="2">مریم احمدی</option>
                                    <option value="3">سارا کریمی</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- ============ ستون اصلی ============ -->
                    <div class="d-flex flex-column flex-row-fluid gap-7 gap-lg-10">

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>اطلاعات پایه</h2></div></div>
                            <div class="card-body pt-0">
                                <div class="row g-9 mb-8">
                                    <div class="col-md-6 fv-row">
                                        <label class="required fs-6 fw-semibold mb-2">نام</label>
                                        <input type="text" id="Form_Name" class="form-control form-control-solid"
                                               placeholder="مثال: دوره جامع ASP.NET Core" />
                                    </div>
                                    <div class="col-md-6 fv-row">
                                        <label class="required fs-6 fw-semibold mb-2">نام لاتین</label>
                                        <input type="text" id="Form_LatinName" class="form-control form-control-solid"
                                               placeholder="Example: Complete ASP.NET Core" dir="ltr" />
                                    </div>
                                </div>

                                <div class="mb-8 fv-row">
                                    <label class="required fs-6 fw-semibold mb-2">اسلاگ</label>
                                    <input type="text" id="Form_Slug" class="form-control form-control-solid"
                                           placeholder="complete-aspnet-core" dir="ltr" />
                                    <div class="text-muted fs-7 mt-1">به‌صورت خودکار از نام لاتین ساخته می‌شود و قابل ویرایش است</div>
                                </div>

                                <div class="mb-8 fv-row">
                                    <label class="fs-6 fw-semibold mb-2">توضیح کوتاه</label>
                                    <textarea id="Form_ShortDescription" class="form-control form-control-solid" rows="3"
                                              maxlength="500" placeholder="خلاصه‌ای از دوره..."></textarea>
                                </div>

                                <div class="fv-row">
                                    <label class="fs-6 fw-semibold mb-2">توضیحات کامل</label>
                                    <textarea id="Form_Description"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>قیمت‌گذاری</h2></div></div>
                            <div class="card-body pt-0">
                                <div class="row g-9 mb-8">
                                    <div class="col-md-6 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">قیمت (تومان)</label>
                                        <input type="text" id="Form_Price" class="form-control form-control-solid"
                                               placeholder="خالی = رایگان" inputmode="numeric" />
                                        <div class="text-muted fs-7 mt-1">در صورت خالی بودن، دوره رایگان محسوب می‌شود</div>
                                    </div>
                                    <div class="col-md-6 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">نوع تخفیف</label>
                                        <select id="Form_DiscountType" class="form-select form-select-solid">
                                            <option value="">بدون تخفیف</option>
                                            <option value="Percent">درصدی</option>
                                            <option value="Fixed">مبلغ ثابت</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-9 mb-8">
                                    <div class="col-md-6 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">مقدار تخفیف <span id="discountUnit" class="text-muted"></span></label>
                                        <input type="text" id="Form_DiscountValue" class="form-control form-control-solid"
                                               inputmode="numeric" disabled />
                                    </div>
                                </div>

                                <div class="d-flex flex-stack">
                                    <div class="me-5">
                                        <label class="fs-6 fw-semibold">فعال بودن فروش</label>
                                        <div class="text-muted fs-7">در صورت غیرفعال بودن، امکان خرید دوره وجود ندارد</div>
                                    </div>
                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" id="Form_IsSaleActive" checked />
                                        <span class="form-check-label fw-semibold text-muted">فعال</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="card card-flush py-4">
                            <div class="card-header"><div class="card-title"><h2>ویدیو معرفی</h2></div></div>
                            <div class="card-body pt-0">
                                <div class="fv-row">
                                    <label class="fs-6 fw-semibold mb-2">آدرس ویدیو</label>
                                    <input type="text" id="Form_IntroductionVideo" class="form-control form-control-solid"
                                           placeholder="https://..." dir="ltr" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!--end::Modal body-->

            <!--begin::Modal footer-->
            <div class="modal-footer">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="kt_course_submit" onclick="submitCourseForm()">
                    <span class="indicator-label">ذخیره</span>
                    <span class="indicator-progress">
                        لطفاً صبر کنید...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
    </div>
</div>

<!-- ==================== مودال حذف ==================== -->
<div class="modal fade" id="kt_modal_delete_course" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <div class="modal-body text-center pt-0 pb-15 px-10">
                <i class="ki-duotone ki-trash fs-5x text-danger mb-5">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    <span class="path4"></span><span class="path5"></span>
                </i>
                <h2 class="mb-3">حذف دوره</h2>
                <div class="text-muted fw-semibold fs-5 mb-8">
                    آیا از حذف دوره
                    <span class="fw-bold text-gray-900" id="delete-course-name"></span>
                    مطمئن هستید؟
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <span class="indicator-label">بله، حذف شود</span>
                        <span class="indicator-progress">
                            لطفاً صبر کنید...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

