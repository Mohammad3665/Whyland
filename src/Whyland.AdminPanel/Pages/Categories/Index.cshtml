@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.Categories.CategoriesModel
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دسته‌بندی‌ها", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت دسته‌بندی‌ها
            </h1>
        </div>
        
        <!--begin::Actions (button on the left)-->
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_category"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن دسته‌بندی جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="categorySearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در دسته‌بندی‌ها..." />
                </div>
                <!--end::Search-->

                <!--begin::Filter-->
                <div class="d-flex align-items-center gap-2">
                    <select id="statusFilter" class="form-select form-select-solid w-150px">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="1">فعال</option>
                        <option value="0">غیرفعال</option>
                    </select>
                </div>
                <!--end::Filter-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_categories_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-start">نام</th>
                            <th class="text-start">نام لاتین</th>
                            <th class="text-start">ترتیب</th>
                            <th class="text-start">والد</th>
                            <th class="text-start">وضعیت</th>
                            <th class="text-start">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Level 1 -->
                        <tr data-active="1">
                            <td>
                                <span class="text-gray-800 fw-bold">برنامه‌نویسی</span>
                            </td>
                            <td><span class="text-gray-600">Programming</span></td>
                            <td><span class="badge badge-light-secondary">1</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/12</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(1, 'برنامه‌نویسی', 'Programming', 1, null, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'برنامه‌نویسی')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 2 — child of "Programming" -->
                        <tr data-active="1">
                            <td>
                                <span style="display:inline-block; width:20px;"></span>
                                <i class="ki-duotone ki-arrow-right fs-6 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-800 fw-bold">برنامه‌نویسی وب</span>
                            </td>
                            <td><span class="text-gray-600">Web Development</span></td>
                            <td><span class="badge badge-light-secondary">1</span></td>
                            <td><span class="badge badge-light-info">برنامه‌نویسی</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/12</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(2, 'برنامه‌نویسی وب', 'Web Development', 1, 1, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'برنامه‌نویسی وب')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 3 — child of "Web Development" -->
                        <tr data-active="1">
                            <td>
                                <span style="display:inline-block; width:40px;"></span>
                                <i class="ki-duotone ki-arrow-right fs-6 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-800 fw-bold">ASP.NET Core</span>
                            </td>
                            <td><span class="text-gray-600">ASP.NET Core</span></td>
                            <td><span class="badge badge-light-secondary">1</span></td>
                            <td><span class="badge badge-light-info">برنامه‌نویسی وب</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/12</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(3, 'ASP.NET Core', 'ASP.NET Core', 1, 2, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'ASP.NET Core')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 2 — child of "Programming" -->
                        <tr data-active="0">
                            <td>
                                <span style="display:inline-block; width:20px;"></span>
                                <i class="ki-duotone ki-arrow-right fs-6 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-800 fw-bold">برنامه‌نویسی موبایل</span>
                            </td>
                            <td><span class="text-gray-600">Mobile Development</span></td>
                            <td><span class="badge badge-light-secondary">2</span></td>
                            <td><span class="badge badge-light-info">برنامه‌نویسی</span></td>
                            <td><span class="badge badge-light-danger">غیرفعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/14</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(4, 'برنامه‌نویسی موبایل', 'Mobile Development', 2, 1, false)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(4, 'برنامه‌نویسی موبایل')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 1 -->
                        <tr data-active="1">
                            <td>
                                <span class="text-gray-800 fw-bold">طراحی گرافیک</span>
                            </td>
                            <td><span class="text-gray-600">Graphic Design</span></td>
                            <td><span class="badge badge-light-secondary">2</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/15</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(5, 'طراحی گرافیک', 'Graphic Design', 2, null, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(5, 'طراحی گرافیک')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 1 -->
                        <tr data-active="1">
                            <td>
                                <span class="text-gray-800 fw-bold">کسب و کار</span>
                            </td>
                            <td><span class="text-gray-600">Business</span></td>
                            <td><span class="badge badge-light-secondary">3</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/18</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(6, 'کسب و کار', 'Business', 3, null, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(6, 'کسب و کار')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Level 1 -->
                        <tr data-active="1">
                            <td>
                                <span class="text-gray-800 fw-bold">زبان‌های خارجی</span>
                            </td>
                            <td><span class="text-gray-600">Foreign Languages</span></td>
                            <td><span class="badge badge-light-secondary">4</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="badge badge-light-success">فعال</span></td>
                            <td><span class="text-gray-600 fs-7">1403/05/20</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(7, 'زبان‌های خارجی', 'Foreign Languages', 4, null, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(7, 'زبان‌های خارجی')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_CategoryModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/categories.js"></script>
}