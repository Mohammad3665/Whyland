@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.Episodes.IndexModel
@{
    ViewData["Title"] = "اپیزودها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = "/Courses/Index", IsActive = false },
        new BreadcrumbItem { Title = "سرفصل‌های دوره", Url = "/CourseSections/Index", IsActive = false },
        new BreadcrumbItem { Title = "اپیزودها", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css" type="text/css" />
    <link rel="stylesheet" href="~/css/episodes.css">
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت اپیزودها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                دوره: <span class="text-gray-800">@Model.CourseTitle</span>
                <span class="mx-1">|</span>
                سرفصل: <span class="text-gray-800">@Model.SectionTitle</span>
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/CourseSections/Index?courseId=@Model.CourseId" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به سرفصل‌ها
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_episode"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن اپیزود جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="episodeSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در اپیزودها..." />
                </div>
                <!--end::Search-->

                <!--begin::Hint-->
                <div class="d-flex align-items-center text-muted fs-7">
                    <i class="ki-duotone ki-arrows-move fs-4 text-gray-500 me-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    برای تغییر ترتیب، سطرها را از ستون «ترتیب» درگ کنید
                </div>
                <!--end::Hint-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_episodes_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col  w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-400px">عنوان اپیزود</th>
                            <th class="text-start nowrap-cell">مدت زمان</th>
                            <th class="text-start">رایگان</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-id="1">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="episode-order badge badge-light-secondary">1</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">معرفی دوره و نصب ابزارها</span></td>
                            <td data-order="865">
                                <i class="ki-duotone ki-time fs-4 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-600">14:25</span>
                            </td>
                            <td><span class="badge badge-light-success">رایگان</span></td>
                            <td class="text-end nowrap-cell">
                                <a href="/EpisodeAttachments/Index?episodeId=1&sectionId=@Model.SectionId&courseId=@Model.CourseId"
                                   class="btn btn-sm btn-icon btn-bg-light btn-active-color-success me-1" title="پیوست‌ها">
                                    <i class="ki-duotone ki-paper-clip fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(1, 'معرفی دوره و نصب ابزارها', '14:25', true, 1)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'معرفی دوره و نصب ابزارها')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="2">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="episode-order badge badge-light-secondary">2</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">ساختار پروژه در ASP.NET Core</span></td>
                            <td data-order="1120">
                                <i class="ki-duotone ki-time fs-4 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-600">18:40</span>
                            </td>
                            <td><span class="badge badge-light-secondary">قفل</span></td>
                            <td class="text-end nowrap-cell">
                                <a href="/EpisodeAttachments/Index?episodeId=2&sectionId=@Model.SectionId&courseId=@Model.CourseId"
                                   class="btn btn-sm btn-icon btn-bg-light btn-active-color-success me-1" title="پیوست‌ها">
                                    <i class="ki-duotone ki-paper-clip fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(2, 'ساختار پروژه در ASP.NET Core', '18:40', false, 2)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'ساختار پروژه در ASP.NET Core')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="3">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="episode-order badge badge-light-secondary">3</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">اجرای اولین برنامه</span></td>
                            <td data-order="730">
                                <i class="ki-duotone ki-time fs-4 text-gray-500 me-1">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <span class="text-gray-600">12:10</span>
                            </td>
                            <td><span class="badge badge-light-success">رایگان</span></td>
                            <td class="text-end nowrap-cell">
                                <a href="/EpisodeAttachments/Index?episodeId=3&sectionId=@Model.SectionId&courseId=@Model.CourseId"
                                   class="btn btn-sm btn-icon btn-bg-light btn-active-color-success me-1" title="پیوست‌ها">
                                    <i class="ki-duotone ki-paper-clip fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(3, 'اجرای اولین برنامه', '12:10', true, 3)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'اجرای اولین برنامه')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_EpisodeModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/episodes.js"></script>
}
