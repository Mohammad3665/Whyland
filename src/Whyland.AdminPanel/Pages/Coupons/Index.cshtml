@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.Coupons.IndexModel
@{
    ViewData["Title"] = "کدهای تخفیف";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "فروش و سفارش‌ها", Url = null, IsActive = false },
        new BreadcrumbItem { Title = "کدهای تخفیف", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت کدهای تخفیف
            </h1>
        </div>

        <!--begin::Actions (button on the left)-->
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_coupon"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن کد تخفیف
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search (by code)-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="couponSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو بر اساس کد..." dir="ltr" />
                </div>
                <!--end::Search-->

                <!--begin::Filter: derived status-->
                <div class="d-flex align-items-center gap-2">
                    <select id="couponStatusFilter" class="form-select form-select-solid w-180px">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="Active">فعال</option>
                        <option value="Scheduled">زمان‌بندی‌شده</option>
                        <option value="Expired">منقضی</option>
                        <option value="Exhausted">اتمام سهمیه</option>
                        <option value="Inactive">غیرفعال</option>
                    </select>
                </div>
                <!--end::Filter-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_coupons_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-start">کد</th>
                            <th class="text-start">نوع</th>
                            <th class="text-start">مقدار</th>
                            <th class="text-start">حداقل مبلغ سفارش</th>
                            <th class="text-start">استفاده شده</th>
                            <th class="text-start">تاریخ شروع</th>
                            <th class="text-start">تاریخ پایان</th>
                            <th class="text-start">وضعیت</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Demo rows — replace with real data when the data layer is wired up.
                             data-* attributes carry the raw fields for the edit modal & JS. -->

                        <!-- Active percentage coupon -->
                        <tr data-status="Active"
                            data-code="NOWROUZ1403" data-type="Percentage" data-value="10"
                            data-min="500000" data-limit="100" data-used="37"
                            data-start="1403/07/01" data-end="1403/09/29" data-active="true"
                            data-id="31250000-0000-0000-0000-000000000201"
                            data-deletable="false">
                            <td><span class="text-gray-800 fw-bold" dir="ltr">NOWROUZ1403</span></td>
                            <td><span class="badge badge-light-info">درصدی</span></td>
                            <td><span class="text-gray-800 fw-bold" dir="ltr">10%</span></td>
                            <td><span class="text-gray-700 nowrap-cell">500,000 تومان</span></td>
                            <td class="nowrap-cell">
                                <span class="text-gray-800 fw-bold">۳۷</span>
                                <span class="text-muted fs-8">/ ۱۰۰</span>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/07/01</span></td>
                            <td><span class="text-gray-600 fs-7">1403/09/29</span></td>
                            <td data-active="true"><span class="badge badge-light-success">فعال</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000201')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-warning me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000201')" title="غیرفعال‌سازی">
                                    <i class="ki-duotone ki-toggle-off fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000201')" title="حذف (کد استفاده‌شده حذف نرم می‌شود)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Active fixed-amount coupon, no min, unused -->
                        <tr data-status="Active"
                            data-code="WELCOME15" data-type="FixedAmount" data-value="150000"
                            data-min="" data-limit="" data-used="0"
                            data-start="1403/07/10" data-end="1404/01/15" data-active="true"
                            data-id="31250000-0000-0000-0000-000000000202"
                            data-deletable="true">
                            <td><span class="text-gray-800 fw-bold" dir="ltr">WELCOME15</span></td>
                            <td><span class="badge badge-light-secondary">مبلغ ثابت</span></td>
                            <td><span class="text-gray-800 fw-bold">150,000 تومان</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-800 fw-bold">۰</span></td>
                            <td><span class="text-gray-600 fs-7">1403/07/10</span></td>
                            <td><span class="text-gray-600 fs-7">1404/01/15</span></td>
                            <td data-active="true"><span class="badge badge-light-success">فعال</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000202')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-warning me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000202')" title="غیرفعال‌سازی">
                                    <i class="ki-duotone ki-toggle-off fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000202')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Scheduled coupon (starts later) -->
                        <tr data-status="Scheduled"
                            data-code="YALDA25" data-type="Percentage" data-value="25"
                            data-min="1000000" data-limit="200" data-used="0"
                            data-start="1403/09/25" data-end="1403/09/30" data-active="true"
                            data-id="31250000-0000-0000-0000-000000000203"
                            data-deletable="true">
                            <td><span class="text-gray-800 fw-bold" dir="ltr">YALDA25</span></td>
                            <td><span class="badge badge-light-info">درصدی</span></td>
                            <td><span class="text-gray-800 fw-bold" dir="ltr">25%</span></td>
                            <td><span class="text-gray-700">1,000,000 تومان</span></td>
                            <td><span class="text-gray-800 fw-bold">۰</span> <span class="text-muted fs-8">/ ۲۰۰</span></td>
                            <td><span class="text-gray-600 fs-7">1403/09/25</span></td>
                            <td><span class="text-gray-600 fs-7">1403/09/30</span></td>
                            <td data-active="true"><span class="badge badge-light-primary">زمان‌بندی‌شده</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000203')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-warning me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000203')" title="غیرفعال‌سازی">
                                    <i class="ki-duotone ki-toggle-off fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000203')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Exhausted coupon (limit reached) -->
                        <tr data-status="Exhausted"
                            data-code="SUMMER20" data-type="Percentage" data-value="20"
                            data-min="" data-limit="50" data-used="50"
                            data-start="1403/04/01" data-end="1403/06/31" data-active="true"
                            data-id="31250000-0000-0000-0000-000000000204"
                            data-deletable="false">
                            <td><span class="text-gray-800 fw-bold" dir="ltr">SUMMER20</span></td>
                            <td><span class="badge badge-light-info">درصدی</span></td>
                            <td><span class="text-gray-800 fw-bold" dir="ltr">20%</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-800 fw-bold">۵۰</span> <span class="text-muted fs-8">/ ۵۰</span></td>
                            <td><span class="text-gray-600 fs-7">1403/04/01</span></td>
                            <td><span class="text-gray-600 fs-7">1403/06/31</span></td>
                            <td data-active="true"><span class="badge badge-light-warning">اتمام سهمیه</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000204')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-warning me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000204')" title="غیرفعال‌سازی">
                                    <i class="ki-duotone ki-toggle-off fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000204')" title="حذف (کد استفاده‌شده حذف نرم می‌شود)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Expired coupon -->
                        <tr data-status="Expired"
                            data-code="RAMADAN10" data-type="FixedAmount" data-value="100000"
                            data-min="300000" data-limit="" data-used="12"
                            data-start="1403/02/01" data-end="1403/03/31" data-active="true"
                            data-id="31250000-0000-0000-0000-000000000205"
                            data-deletable="false">
                            <td><span class="text-gray-800 fw-bold" dir="ltr">RAMADAN10</span></td>
                            <td><span class="badge badge-light-secondary">مبلغ ثابت</span></td>
                            <td><span class="text-gray-800 fw-bold">100,000 تومان</span></td>
                            <td><span class="text-gray-700">300,000 تومان</span></td>
                            <td><span class="text-gray-800 fw-bold">۱۲</span></td>
                            <td><span class="text-gray-600 fs-7">1403/02/01</span></td>
                            <td><span class="text-gray-600 fs-7">1403/03/31</span></td>
                            <td data-active="true"><span class="badge badge-light-dark">منقضی</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000205')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-warning me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000205')" title="غیرفعال‌سازی">
                                    <i class="ki-duotone ki-toggle-off fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000205')" title="حذف (کد استفاده‌شده حذف نرم می‌شود)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Manually deactivated coupon -->
                        <tr data-status="Inactive"
                            data-code="BLACKFRIDAY30" data-type="Percentage" data-value="30"
                            data-min="" data-limit="80" data-used="21"
                            data-start="1403/08/01" data-end="1403/08/10" data-active="false"
                            data-id="31250000-0000-0000-0000-000000000206"
                            data-deletable="false">
                            <td>
                                <span class="text-gray-800 fw-bold" dir="ltr">BLACKFRIDAY30</span>
                            </td>
                            <td><span class="badge badge-light-info">درصدی</span></td>
                            <td><span class="text-gray-800 fw-bold" dir="ltr">30%</span></td>
                            <td><span class="text-muted">—</span></td>
                            <td><span class="text-gray-800 fw-bold">۲۱</span> <span class="text-muted fs-8">/ ۸۰</span></td>
                            <td><span class="text-gray-600 fs-7">1403/08/01</span></td>
                            <td><span class="text-gray-600 fs-7">1403/08/10</span></td>
                            <td data-active="false"><span class="badge badge-light-secondary">غیرفعال</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000206')" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-success me-1"
                                        onclick="toggleActive('31250000-0000-0000-0000-000000000206')" title="فعال‌سازی">
                                    <i class="ki-duotone ki-toggle-on fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000206')" title="حذف (کد استفاده‌شده حذف نرم می‌شود)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_CouponModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/coupons.js"></script>
}
