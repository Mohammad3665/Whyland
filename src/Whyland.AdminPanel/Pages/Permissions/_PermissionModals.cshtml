<!--begin::Create/Edit Modal (same page; section 6.2 of the UI/UX doc)-->
<div class="modal fade" id="kt_modal_permission" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin::Heading-->
                <div class="text-center mb-10">
                    <h2 class="fw-bolder mb-3" id="modal-permission-title">افزودن دسترسی جدید</h2>
                    <div class="text-muted fs-7 fw-semibold">
                        نام و کلید دسترسی را وارد کنید.
                    </div>
                </div>
                <!--end::Heading-->

                <!--begin::Form (demo; no backend handler yet)-->
                <form id="kt_permission_form" class="form" onsubmit="return false;">

                    <!--begin::Input group: Name-->
                    <div class="mb-10">
                        <label class="form-label fs-6 fw-bold text-gray-900" for="Form_Name">
                            <span>نام:</span>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Form_Name" name="Form_Name"
                               class="form-control form-control-solid"
                               placeholder="مثال: انتشار مقاله" />
                        <div class="form-text">نام نمایشی دسترسی در پنل مدیریت.</div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group: Key-->
                    <div class="mb-10">
                        <label class="form-label fs-6 fw-bold text-gray-900" for="Form_Key">
                            <span>کلید (Key):</span>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Form_Key" name="Form_Key"
                               class="form-control form-control-solid" dir="ltr"
                               placeholder="مثال: Blog.Publish" />
                        <div class="form-text">کلید یکتا با قالب <span dir="ltr">Group.Action</span> — بدون فاصله؛ مثال: <span dir="ltr">Blog.Publish</span></div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group: IsSystem (readonly in edit)-->
                    <div class="mb-10">
                        <label class="form-label d-block fs-6 fw-bold text-gray-900">
                            <span>دسترسی سیستمی:</span>
                        </label>
                        <div id="PermissionIsSystemEdit" class="d-none">
                            <span class="badge badge-light-primary">
                                <i class="ki-duotone ki-shield-tick fs-4 me-1">
                                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                    <span class="path4"></span><span class="path5"></span><span class="path6"></span><span class="path7"></span>
                                </i>
                                این دسترسی سیستمی است و نوع آن قابل تغییر نیست
                            </span>
                        </div>
                        <div id="PermissionIsSystemCreate" class="form-check form-switch form-check-solid">
                            <input class="form-check-input" type="checkbox" id="Form_IsSystem" name="Form_IsSystem" />
                            <label class="form-check-label fw-semibold text-gray-700" for="Form_IsSystem">
                                این دسترسی را سیستمی ثبت کن (قابل حذف نخواهد بود)
                            </label>
                        </div>
                    </div>
                    <!--end::Input group-->

                </form>
                <!--end::Form-->
            </div>
            <!--end::Modal body-->

            <!--begin::Modal footer-->
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="kt_permission_submit" onclick="submitPermissionForm()">
                    <span class="indicator-label">ذخیره</span>
                    <span class="indicator-progress">
                        لطفاً صبر کنید...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Create/Edit Modal-->

<!--begin::Delete Confirmation Modal-->
<div class="modal fade" id="kt_modal_delete_permission" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                </div>
            </div>
            <div class="modal-body text-center pt-0 pb-15 px-10">
                <i class="ki-duotone ki-trash fs-5x text-danger mb-5">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    <span class="path4"></span><span class="path5"></span>
                </i>
                <h2 class="mb-3">حذف دسترسی</h2>
                <div class="text-muted fw-semibold fs-5 mb-8">
                    آیا از حذف دسترسی
                    <span class="fw-bold text-gray-900" id="delete-permission-name"></span>
                    مطمئن هستید؟
                </div>
                <div class="text-muted fs-7 mb-8">
                    این دسترسی از همه نقش‌هایی که آن را داشته‌اند برداشته می‌شود.
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <span class="indicator-label">بله، حذف شود</span>
                        <span class="indicator-progress">
                            لطفاً صبر کنید...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end::Delete Confirmation Modal-->
