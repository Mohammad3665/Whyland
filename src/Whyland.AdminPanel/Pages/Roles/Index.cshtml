@page
@using Whyland.AdminPanel.Models
@model Whyland.AdminPanel.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "نقش‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "نقش‌ها", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت نقش‌ها
            </h1>
        </div>

        <!--begin::Actions (button on the left)-->
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_role"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن نقش جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="roleSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در نقش‌ها..." />
                </div>
                <!--end::Search-->

                <!--begin::Filter-->
                <div class="d-flex align-items-center gap-2">
                    <select id="roleTypeFilter" class="form-select form-select-solid w-150px">
                        <option value="">همه نقش‌ها</option>
                        <option value="system">سیستمی</option>
                        <option value="custom">سفارشی</option>
                    </select>
                </div>
                <!--end::Filter-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_roles_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-start">عنوان</th>
                            <th class="text-start">نام (Name)</th>
                            <th class="text-start">نوع</th>
                            <th class="text-start">تعداد کاربران</th>
                            <th class="text-start">دسترسی‌ها</th>
                            <th class="text-start">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Demo rows — replace with real data when the data layer is wired up. -->

                        <!-- System role: SuperAdmin (protected against edit/delete of type) -->
                        <tr data-type="system">
                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-shield-cross fs-2 text-primary me-2" title="نقش سیستمی">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold">مدیر کل</span>
                                </div>
                            </td>
                            <td><span class="text-gray-600" dir="ltr">SuperAdmin</span></td>
                            <td><span class="badge badge-light-primary">سیستمی</span></td>
                            <td><span class="text-gray-800 fw-bold">۱</span></td>
                            <td>
                                <a href="#" class="badge badge-light-info role-permission-badge" data-role-id="31250000-0000-0000-0000-000000000001">۳۲ دسترسی</a>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/01/01</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openPermissionsModal('31250000-0000-0000-0000-000000000001', 'مدیر کل')" title="مدیریت دسترسی‌ها">
                                    <i class="ki-duotone ki-security-user fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000001', 'مدیر کل', 'SuperAdmin', true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000001', 'مدیر کل', true)" title="حذف (نقش سیستمی قابل حذف نیست)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- System role: Admin -->
                        <tr data-type="system">
                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-shield-cross fs-2 text-primary me-1" title="نقش سیستمی">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold">مدیر</span>
                                </div>
                            </td>
                            <td><span class="text-gray-600" dir="ltr">Admin</span></td>
                            <td><span class="badge badge-light-primary">سیستمی</span></td>
                            <td><span class="text-gray-800 fw-bold">۳</span></td>
                            <td>
                                <a href="#" class="badge badge-light-info role-permission-badge" data-role-id="31250000-0000-0000-0000-000000000002">۲۴ دسترسی</a>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/01/01</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openPermissionsModal('31250000-0000-0000-0000-000000000002', 'مدیر')" title="مدیریت دسترسی‌ها">
                                    <i class="ki-duotone ki-security-user fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000002', 'مدیر', 'Admin', true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000002', 'مدیر', true)" title="حذف (نقش سیستمی قابل حذف نیست)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- System role: Instructor -->
                        <tr data-type="system">
                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <i class="ki-duotone ki-shield-cross fs-2 text-primary me-1" title="نقش سیستمی">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="text-gray-800 fw-bold">مدرس</span>
                                </div>
                            </td>
                            <td><span class="text-gray-600" dir="ltr">Instructor</span></td>
                            <td><span class="badge badge-light-primary">سیستمی</span></td>
                            <td><span class="text-gray-800 fw-bold">۲</span></td>
                            <td>
                                <a href="#" class="badge badge-light-info role-permission-badge" data-role-id="31250000-0000-0000-0000-000000000003">۸ دسترسی</a>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/01/01</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openPermissionsModal('31250000-0000-0000-0000-000000000003', 'مدرس')" title="مدیریت دسترسی‌ها">
                                    <i class="ki-duotone ki-security-user fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000003', 'مدرس', 'Instructor', true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000003', 'مدرس', true)" title="حذف (نقش سیستمی قابل حذف نیست)">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Custom role: Content manager -->
                        <tr data-type="custom">
                            <td><span class="text-gray-800 fw-bold">مدیر محتوا</span></td>
                            <td><span class="text-gray-600" dir="ltr">ContentManager</span></td>
                            <td><span class="badge badge-light-secondary">سفارشی</span></td>
                            <td><span class="text-gray-800 fw-bold">۱</span></td>
                            <td>
                                <a href="#" class="badge badge-light-info role-permission-badge" data-role-id="31250000-0000-0000-0000-000000000004">۱۰ دسترسی</a>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/04/18</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openPermissionsModal('31250000-0000-0000-0000-000000000004', 'مدیر محتوا')" title="مدیریت دسترسی‌ها">
                                    <i class="ki-duotone ki-security-user fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000004', 'مدیر محتوا', 'ContentManager', false)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000004', 'مدیر محتوا', false)" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <!-- Custom role: Support (inactive example removed — Role has no IsActive; all listed roles exist) -->
                        <tr data-type="custom">
                            <td><span class="text-gray-800 fw-bold">پشتیبان فروش</span></td>
                            <td><span class="text-gray-600" dir="ltr">SalesSupport</span></td>
                            <td><span class="badge badge-light-secondary">سفارشی</span></td>
                            <td><span class="text-gray-800 fw-bold">۰</span></td>
                            <td>
                                <a href="#" class="badge badge-light-info role-permission-badge" data-role-id="31250000-0000-0000-0000-000000000005">۵ دسترسی</a>
                            </td>
                            <td><span class="text-gray-600 fs-7">1403/06/02</span></td>
                            <td class="text-end actions-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openPermissionsModal('31250000-0000-0000-0000-000000000005', 'پشتیبان فروش')" title="مدیریت دسترسی‌ها">
                                    <i class="ki-duotone ki-security-user fs-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal('31250000-0000-0000-0000-000000000005', 'پشتیبان فروش', 'SalesSupport', false)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal('31250000-0000-0000-0000-000000000005', 'پشتیبان فروش', false)" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_RoleModals" />

@section Scripts {
    <script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/js/common/admin-crud.js"></script>
    <script src="~/js/roles.js"></script>
}
