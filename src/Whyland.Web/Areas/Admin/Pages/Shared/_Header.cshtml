@using Whyland.Web.Common.Identity.Services
@inject CurrentUserMenuService CurrentUserMenuService
@{
    #region Active menu helpers
    string? current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool IsActive(params string[] pages) =>
        pages.Any(p =>
        {
            string? folder = p.EndsWith("/Index") ? p[..^"/Index".Length] : p;
            if (folder == "") return current == "/Index";
            return current == p || current.StartsWith(folder + "/");
        });

    string Open(params string[] pages)   => IsActive(pages) ? "here show" : "";
    #endregion

    #region Signed-in user
    // The same read the public header makes, so the two menus can never disagree about who is
    // signed in, what avatar they have, or whether the panel is theirs.
    CurrentUserMenu? userMenu = User.Identity?.IsAuthenticated == true
        ? await CurrentUserMenuService.GetAsync(User)
        : null;
    #endregion
}
