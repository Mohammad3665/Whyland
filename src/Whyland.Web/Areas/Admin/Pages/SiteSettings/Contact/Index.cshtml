@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.SiteSettings.Contact.IndexModel
@{
    ViewData["Title"] = "اطلاعات تماس";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "تنظیمات", Url = null, IsActive = false },
        new BreadcrumbItem { Title = "اطلاعات تماس", Url = null, IsActive = true }
    };
}

<!--begin::Settings page (read-only view + edit modal)-->

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                اطلاعات تماس
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                تلفن، ایمیل و آدرس دفتر
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_settings_edit"
                    onclick="openSettingsModal()">
                <i class="ki-duotone ki-pencil fs-4 me-1"><span class="path1"></span><span class="path2"></span></i>
                ویرایش تنظیمات
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush" id="kt_settings_page" data-settings-group="contact">
            <!--begin::Card header-->
            <div class="card-header pt-7">
                <div class="card-title">
                    <div class="d-flex flex-column">
                        <h2 class="fw-bold text-gray-900 mb-1">مقادیر فعلی</h2>
                        <span class="text-muted fw-semibold fs-7">
                            این اطلاعات در صفحه «تماس با ما» و فوتر وب‌سایت نمایش داده می‌شود
                        </span>
                    </div>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-5">
                <div class="row g-6 g-xl-9">

                    <!--begin::Item - Phone-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">تلفن</div>
                        <div class="text-gray-800 fs-6 fw-bold" id="View_Phone"
                             data-value="021-12345678">021-12345678</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Email-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">ایمیل</div>
                        <div class="text-gray-800 fs-6 fw-bold" id="View_Email"
                             data-value="info@whyland.ir">info@whyland.ir</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Address-->
                    <div class="col-12">
                        <div class="fs-7 fw-semibold text-muted mb-2">آدرس</div>
                        <div class="text-gray-800 fs-6 lh-lg" id="View_Address"
                             data-value="تهران، خیابان ولیعصر، بالاتر از پارک ساعی، پلاک ۱۲، طبقه ۳، واحد ۵">
                            تهران، خیابان ولیعصر، بالاتر از پارک ساعی، پلاک ۱۲، طبقه ۳، واحد ۵
                        </div>
                    </div>
                    <!--end::Item-->
                </div>
            </div>
            <!--end::Card body-->

            <!--begin::Card footer-->
            <div class="card-footer pt-5">
                <div class="text-muted fs-7">
                    آخرین بروزرسانی:
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedText</span>
                    توسط
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedBy</span>
                </div>
            </div>
            <!--end::Card footer-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_ContactModals" />

@section Scripts {
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/site-settings.js"></script>
}
