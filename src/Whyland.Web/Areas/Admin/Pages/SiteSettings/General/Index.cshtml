@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.SiteSettings.General.IndexModel
@{
    ViewData["Title"] = "تنظیمات عمومی";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "تنظیمات", Url = null, IsActive = false },
        new BreadcrumbItem { Title = "تنظیمات عمومی", Url = null, IsActive = true }
    };
}

<!--begin::Settings page (read-only view + edit modal)-->

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                تنظیمات عمومی
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                عنوان سایت، لوگو، فاوآیکون و توضیحات
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_settings_edit"
                    onclick="openSettingsModal()">
                <i class="ki-duotone ki-pencil fs-4 me-1"><span class="path1"></span><span class="path2"></span></i>
                ویرایش تنظیمات
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush" id="kt_settings_page" data-settings-group="general">
            <!--begin::Card header-->
            <div class="card-header pt-7">
                <div class="card-title">
                    <div class="d-flex flex-column">
                        <h2 class="fw-bold text-gray-900 mb-1">مقادیر فعلی</h2>
                        <span class="text-muted fw-semibold fs-7">
                            این مقادیر در سراسر وب‌سایت عمومی استفاده می‌شوند
                        </span>
                    </div>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-5">
                <div class="row g-6 g-xl-9">

                    <!--begin::Item - Site title-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">عنوان سایت</div>
                        <div class="text-gray-800 fs-6 fw-bold" id="View_SiteTitle"
                             data-value="آکادمی وایلند">آکادمی وایلند</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Site description-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">توضیحات سایت</div>
                        <div class="text-gray-800 fs-6 lh-lg" id="View_SiteDescription"
                             data-value="آکادمی آنلاین وایلند؛ آموزش تخصصی برنامه‌نویسی، طراحی و مهارت‌های دیجیتال با تدریس اساتید باتجربه.">
                            آکادمی آنلاین وایلند؛ آموزش تخصصی برنامه‌نویسی، طراحی و مهارت‌های دیجیتال با تدریس اساتید باتجربه.
                        </div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Logo (light theme)-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">لوگو (تم روشن)</div>
                        <div class="d-flex align-items-center justify-content-center bg-white border border-gray-300 border-dashed rounded p-3"
                             style="height: 90px;">
                            <img id="View_LogoDark" data-value="~/admin/assets/media/logos/logo-dark.png"
                                 src="~/admin/assets/media/logos/logo-dark.png" alt="لوگوی تم روشن"
                                 class="mw-100 mh-100 object-fit-contain"
                                 onerror="this.onerror=null;this.src='~/assets/media/svg/files/blank-image.svg';" />
                        </div>
                        <div class="text-muted fs-7 mt-1">لوگویی که در پس‌زمینه روشن سایت نمایش داده می‌شود</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Logo (dark theme)-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">لوگو (تم تیره)</div>
                        <div class="d-flex align-items-center justify-content-center border border-gray-300 border-dashed rounded p-3"
                             style="height: 90px; background-color: #1e1e2d;">
                            <img id="View_LogoLight" data-value="~/admin/assets/media/logos/logo-light.png"
                                 src="~/admin/assets/media/logos/logo-light.png" alt="لوگوی تم تیره"
                                 class="mw-100 mh-100 object-fit-contain"
                                 onerror="this.onerror=null;this.src='~/admin/assets/media/svg/files/blank-image.svg';" />
                        </div>
                        <div class="text-muted fs-7 mt-1">لوگویی که در پس‌زمینه تیره سایت نمایش داده می‌شود</div>
                    </div>
                    <!--end::Item-->

                    <!--begin::Item - Favicon-->
                    <div class="col-md-6">
                        <div class="fs-7 fw-semibold text-muted mb-2">فاوآیکون</div>
                        <div class="d-flex align-items-center justify-content-center bg-white border border-gray-300 border-dashed rounded"
                             style="width: 72px; height: 72px;">
                            <img id="View_Favicon" data-value="/fav-icon.png"
                                 src="/fav-icon.png" alt="فاوآیکون"
                                 class="mw-100 mh-100 object-fit-contain p-2"
                                 onerror="this.onerror=null;this.src='/assets/media/svg/files/blank-image.svg';" />
                        </div>
                        <div class="text-muted fs-7 mt-1">آیکونی که در تب مرورگر نمایش داده می‌شود</div>
                    </div>
                    <!--end::Item-->
                </div>
            </div>
            <!--end::Card body-->

            <!--begin::Card footer-->
            <div class="card-footer pt-5">
                <div class="text-muted fs-7">
                    آخرین بروزرسانی:
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedText</span>
                    توسط
                    <span class="text-gray-700 fw-semibold">@Model.LastUpdatedBy</span>
                </div>
            </div>
            <!--end::Card footer-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_GeneralModals" />

@section Scripts {
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/site-settings.js"></script>
}
