@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Authorization.Roles.IndexModel
@{
    ViewData["Title"] = "نقش‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "نقش‌ها", Url = null, IsActive = true }
    };
}

@* Antiforgery token required by the modal POST handlers (read by roles.js). *@
@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت نقش‌ها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                نقش‌های سیستمی قابل ویرایش نیستند؛ فقط نقش‌های سفارشی را می‌توان تغییر داد یا حذف کرد
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن نقش جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header - generic filter picker-->
            <!-- The field list and the operators of each field come from ?handler=Fields, so any
                 role column — including the two counted ones — can be searched, filtered or sorted
                 without markup changes. Same picker as the users page, same shared module behind it. -->
            <div class="card-header align-items-center py-5 flex-wrap gap-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="fs-7 fw-semibold text-muted" for="filterField">فیلتر روی:</label>
                    <select id="filterField" class="form-select form-select-solid w-175px"></select>
                    <select id="filterOperator" class="form-select form-select-solid w-150px" dir="ltr"></select>
                    <!-- The value control is rebuilt from the selected field kind (text, number,
                         date or an option list), so no field needs its own markup. -->
                    <div id="filterValueWrap" class="d-flex align-items-center"></div>
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                            title="افزودن فیلتر" onclick="addFilterCondition()">
                        <i class="ki-duotone ki-plus fs-2"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light" onclick="clearFilterConditions()">
                        پاک کردن فیلترها
                    </button>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Active conditions-->
            <div id="filterChips" class="d-flex flex-wrap gap-2 px-5 pb-3"></div>
            <!--end::Active conditions-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_roles_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            @* The title is what an operator reads, so it gets the widest column of the
                               row; the counts are single numbers and get the least. Every header is
                               nowrap: a width class narrower than the phrase behind it would split
                               «تعداد کاربران» over two lines. *@
                            <th class="text-start text-nowrap w-150px">عنوان</th>
                            <th class="text-start text-nowrap w-150px">نام (Name)</th>
                            <th class="text-start text-nowrap w-100px">نوع</th>
                            <th class="text-start text-nowrap w-100px">تعداد کاربران</th>
                            <th class="text-start text-nowrap w-100px">دسترسی‌ها</th>
                            <th class="text-start text-nowrap w-125px">تاریخ ایجاد</th>
                            <th class="text-start text-nowrap">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                    <!-- Rows are loaded from ?handler=Rows by wwwroot/admin/js/roles.js. -->
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_RoleModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/common/admin-table.js"></script>
    <script src="~/admin/js/roles.js"></script>
}
