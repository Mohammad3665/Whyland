@model Whyland.Web.Areas.Admin.Pages.Authorization.Roles.IndexModel
<!--begin::Create/Edit Modal (same page; section 5.2 of the UI/UX doc)-->
<div class="modal fade" id="kt_modal_role" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin::Heading-->
                <div class="text-center mb-10">
                    <h2 class="fw-bolder mb-3" id="modal-role-title">افزودن نقش جدید</h2>
                    <div class="text-muted fs-7 fw-semibold">
                        نام و عنوان نقش را وارد کنید.
                    </div>
                </div>
                <!--end::Heading-->

                <!--begin::Form-->
                <!-- There is no IsSystem control here on purpose: the flag marks the rows the seeder
                     created and the code looks roles up by name, so it is never an operator's choice.
                     CreateRoleCommand always writes false and the commands refuse to change a system
                     role whatever the client sends. -->
                <form id="kt_role_form" class="form" onsubmit="return false;">

                    <!--begin::Input group: Title-->
                    <div class="mb-10">
                        <label class="form-label fs-6 fw-bold text-gray-900" for="Form_Title">
                            <span>عنوان:</span>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Form_Title" name="Form_Title" class="form-control form-control-solid"
                               placeholder="مثال: مدیر محتوا" />
                        <div class="form-text">عنوان نمایشی نقش در پنل مدیریت.</div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Input group: Name-->
                    <div class="mb-10">
                        <label class="form-label fs-6 fw-bold text-gray-900" for="Form_Name">
                            <span>نام (Name):</span>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="Form_Name" name="Form_Name" class="form-control form-control-solid"
                               dir="ltr" placeholder="مثال: ContentManager" />
                        <div class="form-text">شناسه انگلیسی و یکتا؛ بدون فاصله — مثال: ContentManager</div>
                    </div>
                    <!--end::Input group-->

                </form>
                <!--end::Form-->
            </div>
            <!--end::Modal body-->

            <!--begin::Modal footer-->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="kt_role_submit" onclick="submitRoleForm()">
                    <span class="indicator-label">ذخیره</span>
                    <span class="indicator-progress">
                        لطفاً صبر کنید...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Create/Edit Modal-->

<!--begin::Delete Confirmation Modal-->
<div class="modal fade" id="kt_modal_delete_role" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                </div>
            </div>
            <div class="modal-body text-center pt-0 pb-15 px-10">
                <i class="ki-duotone ki-trash fs-5x text-danger mb-5">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    <span class="path4"></span><span class="path5"></span>
                </i>
                <h2 class="mb-3">حذف نقش</h2>
                <div class="text-muted fw-semibold fs-5 mb-8">
                    آیا از حذف نقش
                    <span class="fw-bold text-gray-900" id="delete-role-name"></span>
                    مطمئن هستید؟
                </div>
                <!-- States what DeleteRoleCommand really does, in the same save: the role leaves every
                     account that holds it and all of its grants are revoked. Accounts keep their
                     ordinary «User» role; only this one is taken away. -->
                <div class="text-muted fs-7 mb-8">
                    با حذف این نقش، از همهٔ کاربران جدا می‌شود و تمام دسترسی‌های آن برداشته می‌گردد.
                    نقش پیش‌فرض «کاربر» برای همه باقی می‌ماند.
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <span class="indicator-label">بله، حذف شود</span>
                        <span class="indicator-progress">
                            لطفاً صبر کنید...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end::Delete Confirmation Modal-->

<!--begin::Role Permissions Modal (section 5.3)-->
<div class="modal fade" id="kt_modal_role_permissions" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-700px">
        <!--begin::Modal content-->
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <!--begin::Close-->
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-10">
                <!--begin::Heading-->
                <div class="text-center mb-8">
                    <h2 class="fw-bolder mb-3">مدیریت دسترسی‌های نقش</h2>
                    <div class="text-muted fs-7 fw-semibold">
                        نقش: <span class="fw-bold text-gray-800" id="permissions-role-name">—</span>
                    </div>
                </div>
                <!--end::Heading-->

                @* Rendered from the live Permission rows (Model.PermissionGroups), grouped by the
                   prefix of each key, and ticked afterwards from ?handler=Granted. A key retired from
                   the code leaves the tree with the row that held it; a key declared in code but never
                   seeded cannot be granted at all — which is the point of rendering the table. *@
                <div id="role_permissions_list" class="d-flex flex-column gap-6">

                    @foreach (IndexModel.PermissionGroup group in Model.PermissionGroups)
                    {
                        <!--begin::Group-->
                        <div class="rounded border border-gray-300 p-6">
                            <div class="form-check form-check-custom form-check-solid form-check-sm mb-4">
                                <input class="form-check-input perm-group" type="checkbox" id="perm_group_@group.Module"
                                       data-group="@group.Module" />
                                <label class="form-check-label fs-6 fw-bold text-gray-900" for="perm_group_@group.Module">
                                    @group.Title
                                </label>
                            </div>
                            <div class="row g-4">
                                @foreach (Whyland.Shared.Dtos.Authorization.Permission.PermissionOptionDto permission in
                            group.Items)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check form-check-custom form-check-solid form-check-sm">
                                            <input class="form-check-input perm-item" type="checkbox" id="perm_@permission.Id"
                                                   data-group="@group.Module" data-perm-id="@permission.Id" />
                                            <label class="form-check-label fs-7 text-gray-700" for="perm_@permission.Id">
                                                @permission.Name
                                                <span class="text-muted fs-8 ms-1" dir="ltr">@permission.Key</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <!--end::Group-->
                    }

                    @if (Model.PermissionGroups.Count == 0)
                    {
                        <div class="alert alert-light-warning d-flex align-items-center" role="alert">
                            <i class="ki-duotone ki-information-5 fs-2 me-2">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                            </i>
                            <div class="fw-semibold fs-7">
                                فهرست دسترسی‌ها خوانده نشد؛ صفحه را دوباره باز کنید.
                            </div>
                        </div>
                    }

                </div>
                <!--end::Permission groups-->

                <!--begin::System role notice (shown by roles.js, for a system role only). It starts
                     hidden in the markup instead of visible until a script hides it: a cached, failing
                     or never-run script would otherwise leave this claim on screen for every custom
                     role, and the save button it explains is still there.-->
                <div id="permissions-readonly-note" class="alert alert-light align-items-center mt-6 d-none"
                     role="alert">
                    <i class="ki-duotone ki-shield-cross fs-2 me-2 text-primary">
                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span
                        class="path10"></span>
                    </i>
                    <div class="fw-semibold fs-7 text-muted">
                        این نقش سیستمی است؛ دسترسی‌های آن فقط قابل مشاهده است و با تغییرات کد و seed تعیین می‌شود.
                    </div>
                </div>
                <!--end::System role notice-->
            </div>
            <!--end::Modal body-->

            <!--begin::Modal footer-->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="kt_role_permissions_submit"
                        onclick="saveRolePermissions()">
                    <span class="indicator-label">ذخیره دسترسی‌ها</span>
                    <span class="indicator-progress">
                        لطفاً صبر کنید...
                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                    </span>
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Role Permissions Modal-->

<!--begin::Details Modal (every field of the role, section 5.1)-->
@* Same rule as the category page: the listing already carries every column of a role, so opening
   this modal is a lookup in the rows the table holds and never a second round-trip. The delete
   bookkeeping columns are deliberately absent - a row of this list is a live row. *@
<div class="modal fade" id="kt_modal_role_details" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <!--begin::Summary-->
                <div class="d-flex flex-center flex-column mb-8">
                    <h3 class="mb-1 text-gray-900 fw-bold fs-4" id="rd-title">—</h3>
                    <div class="text-muted fs-7" id="rd-type">—</div>
                </div>
                <!--end::Summary-->

                <!--begin::Identity-->
                <h3 class="mb-4 text-gray-900 fw-bold fs-5">مشخصه‌های نقش</h3>
                <div class="table-responsive mb-6">
                    <table class="table table-row-dashed table-row-border fs-6 align-middle m-0">
                        <tbody>
                            <tr>
                                <td class="text-muted w-200px">شناسه</td>
                                <td id="rd-id">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">نام (Name)</td>
                                <td id="rd-name">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">عنوان</td>
                                <td id="rd-role-title">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">نوع نقش</td>
                                <td id="rd-kind">—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--end::Identity-->

                <!--begin::Counts-->
                <h3 class="mb-4 text-gray-900 fw-bold fs-5">شمارش‌ها</h3>
                <div class="table-responsive mb-6">
                    <table class="table table-row-dashed table-row-border fs-6 align-middle m-0">
                        <tbody>
                            <tr>
                                <td class="text-muted w-200px">تعداد کاربران</td>
                                <td id="rd-users">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">تعداد دسترسی‌ها</td>
                                <td id="rd-permissions">—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--end::Counts-->

                <!--begin::Audit-->
                <h3 class="mb-4 text-gray-900 fw-bold fs-5">ضبط تغییرات</h3>
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-border fs-6 align-middle m-0">
                        <tbody>
                            <tr>
                                <td class="text-muted w-200px">تاریخ ایجاد</td>
                                <td id="rd-created">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">ایجاد کننده</td>
                                @* The row carries the author's full name, so the cell reads right-to-left. *@
                                <td id="rd-created-by">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">تاریخ آخرین ویرایش</td>
                                <td id="rd-updated">—</td>
                            </tr>
                            <tr>
                                <td class="text-muted">ویرایش کننده</td>
                                <td id="rd-updated-by">—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--end::Audit-->
            </div>
            <!--end::Modal body-->

            <!--begin::Modal footer-->
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">بستن</button>
                @* Hidden by roles.js for a system role: those rows are named by the seeder, so the
                   only write offered here is the one the commands already refuse. *@
                <button type="button" class="btn btn-primary" id="rd_edit_button" onclick="editRoleFromDetails()">
                    ویرایش نقش
                </button>
                <button type="button" class="btn btn-info" id="rd_permissions_button" onclick="permissionsFromDetails()">
                    مدیریت دسترسی‌ها
                </button>
            </div>
            <!--end::Modal footer-->
        </div>
    </div>
</div>
<!--end::Details Modal-->
