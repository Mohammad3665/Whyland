@page "{id:guid}"
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.InstructorProfile.DetailsModel
@{
    ViewData["Title"] = "پروفایل مدرس";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "مدرسین", Url = "/Admin/InstructorProfile/Index", IsActive = false },
        new BreadcrumbItem { Title = "پروفایل مدرس", Url = null, IsActive = true }
    };

    var fullName = Model.Profile.FirstName + " " + Model.Profile.LastName;
    var hasSheba = !string.IsNullOrWhiteSpace(Model.Profile.ShebaNumber);
    var firstInitial = Model.Profile.FirstName.Length > 0 ? Model.Profile.FirstName[..1] : "";
    var lastInitial = Model.Profile.LastName.Length > 0 ? Model.Profile.LastName[..1] : "";
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                پروفایل مدرس
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                اطلاعات عمومی و مالی مدرس: <span class="text-gray-800 fw-bold">@fullName</span>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a asp-page="./Index" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به مدرسان
            </a>
            <a asp-page="./Index" asp-route-edit="@Model.Profile.Id" class="btn btn-sm fw-bold btn-primary">
                <i class="ki-duotone ki-pencil fs-4 me-1"></i>
                ویرایش پروفایل
            </a>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="row g-6 g-xl-9">
            <div class="col-xl-4">
                <div class="card card-flush">
                    <div class="card-body d-flex flex-column align-items-center text-center py-10">
                        <div class="symbol symbol-150px symbol-circle mb-6 overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(Model.Profile.ProfileImageUrl))
                            {
                                <img src="@Model.Profile.ProfileImageUrl" alt="@fullName"
                                     style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                            }
                            else
                            {
                                <span class="symbol-label bg-light-primary text-primary fs-1 fw-bold">
                                    @firstInitial‌@lastInitial
                                </span>
                            }
                            <span class="symbol-badge badge badge-light-primary start-100 translate-middle mt-n2">
                                مدرس
                            </span>
                        </div>

                        <div class="text-gray-800 fw-bold fs-4 mb-1">@fullName</div>
                        <div class="text-muted fs-7 mb-8">
                            @(Model.Profile.Specialization ?? "بدون تخصص ثبت‌شده")
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(Model.Profile.Website))
                            {
                                <a href="@Model.Profile.Website" class="btn btn-sm btn-light" target="_blank" rel="noopener">
                                    <i class="fas fa-globe fs-4 me-1"></i> وب‌سایت
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Profile.LinkedIn))
                            {
                                <a href="@Model.Profile.LinkedIn" class="btn btn-sm btn-light" target="_blank" rel="noopener">
                                    <i class="fab fa-linkedin-in fs-4 me-1"></i> لینکدین
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Profile.Instagram))
                            {
                                <a href="@Model.Profile.Instagram" class="btn btn-sm btn-light" target="_blank" rel="noopener">
                                    <i class="fab fa-instagram fs-4 me-1"></i> اینستاگرام
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="d-flex flex-column gap-6 gap-xl-9">
                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title"><h2 class="fw-bold text-gray-900">بیوگرافی</h2></div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="mb-8">
                                <div class="fs-7 fw-semibold text-muted mb-2">بیوگرافی کوتاه</div>
                                <div class="text-gray-800 fs-6" style="white-space: pre-wrap;">@(Model.Profile.Bio ?? "—")</div>
                            </div>
                            <div>
                                <div class="fs-7 fw-semibold text-muted mb-2">بیوگرافی کامل</div>
                                <div class="text-gray-800 fs-6 lh-lg" style="white-space: pre-wrap;">@(Model.Profile.Biography ?? "—")</div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title"><h2 class="fw-bold text-gray-900">اطلاعات مدرس</h2></div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="row g-6">
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">تخصص</div>
                                    <div class="text-gray-800 fs-6">@(Model.Profile.Specialization ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">تعداد دوره‌ها</div>
                                    <div class="text-gray-800 fs-6">@Model.Profile.CourseCount.ToString("N0")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">ایمیل</div>
                                    <div class="text-gray-800 fs-6" dir="ltr">@(Model.Profile.Email ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">شماره موبایل</div>
                                    <div class="text-gray-800 fs-6" dir="ltr">@(Model.Profile.PhoneNumber ?? "—")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-flush">
                        <div class="card-header pt-7">
                            <div class="card-title"><h2 class="fw-bold text-gray-900">اطلاعات مالی</h2></div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="row g-6">
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">شماره شبا</div>
                                    <div class="d-flex flex-nowrap align-items-center">
                                        <div class="fs-6 text-gray-800 text-nowrap flex-grow-1 text-truncate" dir="ltr" id="View_ShebaNumber">
                                            @(hasSheba ? "IR" + Model.Profile.ShebaNumber : "—")
                                        </div>
                                        @if (hasSheba)
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-active-color-primary flex-shrink-0 ms-2"
                                                    title="کپی شماره شبا" onclick="copyToClipboard('View_ShebaNumber', this)">
                                                <i class="ki-duotone ki-copy fs-3"><span class="path1"></span><span class="path2"></span></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-7 fw-semibold text-muted mb-2">شماره حساب</div>
                                    <div class="d-flex flex-nowrap align-items-center">
                                        <div class="fs-6 text-gray-800 text-nowrap flex-grow-1 text-truncate" dir="ltr" id="View_BankAccountNumber">
                                            @(Model.Profile.BankAccountNumber ?? "—")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.Profile.BankAccountNumber))
                                        {
                                            <button type="button" class="btn btn-sm btn-icon btn-active-color-primary flex-shrink-0 ms-2"
                                                    title="کپی شماره حساب" onclick="copyToClipboard('View_BankAccountNumber', this)">
                                                <i class="ki-duotone ki-copy fs-3"><span class="path1"></span><span class="path2"></span></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-flush">
                        <div class="card-body py-5 d-flex flex-wrap gap-6 text-muted fs-7">
                            <span>تاریخ ایجاد: @Model.Profile.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            <span>آخرین ویرایش: @(Model.Profile.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->

@section Scripts {
    <script src="~/admin/js/instructor-profile.js"></script>
}
