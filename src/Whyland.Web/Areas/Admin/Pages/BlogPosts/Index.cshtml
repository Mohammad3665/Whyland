@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.BlogPosts.BlogPostsModel
@{
    ViewData["Title"] = "مقالات";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "مقالات", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <style>
        /* #region TinyMCE z-index fixes — dialogs and menus must render above the fullscreen modal */
        .tox-tinymce-aux,
        .tox .tox-dialog-wrap,
        .tox .tox-silver-sink { z-index: 2000 !important; }
        .tox-tinymce { border-radius: .475rem !important; border-color: var(--bs-gray-300, #dbdfe9) !important; }
        /* #endregion */
    </style>
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت مقالات
            </h1>
        </div>
        <div class="d-flex align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن مقاله جدید
            </button>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="blogPostSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در مقالات..." />
                </div>
                <!--end::Search-->

                <!--begin::Filters-->
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <select id="statusFilter" class="form-select form-select-solid w-150px">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="draft">پیش‌نویس</option>
                        <option value="published">منتشر شده</option>
                        <option value="hidden">مخفی</option>
                    </select>
                    <select id="categoryFilter" class="form-select form-select-solid w-175px">
                        <option value="">همه دسته‌بندی‌ها</option>
                        <option value="1">اخبار</option>
                        <option value="2">اخبار فناوری</option>
                        <option value="3">آموزش</option>
                        <option value="5">کسب و کار</option>
                    </select>
                </div>
                <!--end::Filters-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_blog_posts_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-start">تصویر</th>
                            <th class="text-start">عنوان</th>
                            <th class="text-start">نویسنده</th>
                            <th class="text-start">دسته‌بندی</th>
                            <th class="text-start">وضعیت نمایش</th>
                            <th class="text-start">ترتیب</th>
                            <th class="text-start">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-status="published" data-categories="2" data-id="1">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/admin/assets/media/stock/600x400/img-8.jpg" alt="ASP.NET Core 8" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold nowrap-cell">معرفی ASP.NET Core 8</span></td>
                            <td><span class="text-gray-600 nowrap-cell">علی رضایی</span></td>
                            <td><span class="badge badge-light-info">اخبار فناوری</span></td>
                            <td><span class="badge badge-light-success">منتشر شده</span></td>
                            <td><span class="badge badge-light-secondary">1</span></td>
                            <td><span class="text-gray-600 fs-7">1403/06/02</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(1)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'معرفی ASP.NET Core 8')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="published" data-categories="1" data-id="2">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/admin/assets/media/stock/600x400/img-9.jpg" alt="Blazor" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">راهنمای شروع با Blazor</span></td>
                            <td><span class="text-gray-600">مریم احمدی</span></td>
                            <td><span class="badge badge-light-info">اخبار</span></td>
                            <td><span class="badge badge-light-success">منتشر شده</span></td>
                            <td><span class="badge badge-light-secondary">2</span></td>
                            <td><span class="text-gray-600 fs-7">1403/06/05</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(2)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'راهنمای شروع با Blazor')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="draft" data-categories="3" data-id="3">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/admin/assets/media/svg/files/blank-image.svg" alt="SQL Server" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">گام‌های اول SQL Server</span></td>
                            <td><span class="text-gray-600">سارا کریمی</span></td>
                            <td><span class="badge badge-light-info">آموزش</span></td>
                            <td><span class="badge badge-light-secondary">پیش‌نویس</span></td>
                            <td><span class="badge badge-light-secondary">3</span></td>
                            <td><span class="text-gray-600 fs-7">1403/06/10</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(3)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'گام‌های اول SQL Server')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-status="hidden" data-categories="5" data-id="4">
                            <td>
                                <div class="symbol symbol-60px symbol-2by3">
                                    <img src="~/admin/assets/media/stock/600x400/img-10.jpg" alt="Marketing" />
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">بازاریابی محتوایی برای دوره‌های آنلاین</span></td>
                            <td><span class="text-gray-600">علی رضایی</span></td>
                            <td><span class="badge badge-light-info">کسب و کار</span></td>
                            <td><span class="badge badge-light-dark">مخفی</span></td>
                            <td><span class="badge badge-light-secondary">4</span></td>
                            <td><span class="text-gray-600 fs-7">1403/06/12</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1" onclick="openEditModal(4)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(4, 'بازاریابی محتوایی برای دوره‌های آنلاین')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_BlogPostModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/tinymce/tinymce.bundle.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/common/html-editor.js"></script>
    <script src="~/admin/js/blog-posts.js"></script>
}
