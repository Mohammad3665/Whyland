@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Faqs.FaqsModel
@{
    ViewData["Title"] = "سوالات متداول";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "محتوا", Url = "/BlogPosts/Index", IsActive = false },
        new BreadcrumbItem { Title = "سوالات متداول", Url = null, IsActive = true }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت سوالات متداول
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                سوالات متداول عمومی وب‌سایت
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_faq"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن سوال جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="faqSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در سوالات..." />
                </div>
                <!--end::Search-->

                <!--begin::Status filter-->
                <div class="d-flex align-items-center gap-2">
                    <select id="statusFilter" class="form-select form-select-sm form-select-solid w-150px" data-control="select2" data-placeholder="همه">
                        <option value=""></option>
                        <option value="1">فعال</option>
                        <option value="0">غیرفعال</option>
                    </select>
                </div>
                <!--end::Status filter-->

                <!--begin::Hint-->
                <div class="d-flex align-items-center text-muted fs-7">
                    <i class="ki-duotone ki-arrows-move fs-4 text-gray-500 me-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    برای تغییر ترتیب، سطرها را از ستون «ترتیب» درگ کنید
                </div>
                <!--end::Hint-->
            </div>
            <!--end::Card header-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_faqs_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-400px">عنوان سوال</th>
                            <th class="text-center w-100px">وضعیت</th>
                            <th class="text-start nowrap-cell">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Demo rows — replace with real data when the data layer is wired up. -->
                        <tr data-id="1" data-active="1">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="faq-order badge badge-light-secondary">1</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">چگونه می‌توانم ثبت‌نام کنم؟</span></td>
                            <td class="text-center" data-order="1">
                                <span class="badge badge-light-success">فعال</span>
                            </td>
                            <td data-order="2026-09-15"><span class="text-gray-600">۱۴۰۴/۰۶/۲۴</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1"
                                        onclick="openDetailsModal('چگونه می‌توانم ثبت‌نام کنم؟', 'برای ثبت‌نام روی دکمه «ثبت‌نام» در صفحه ورود کلیک کنید و شماره موبایل خود را وارد نمایید.')" title="جزئیات">
                                    <i class="ki-duotone ki-eye fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(1, 'چگونه می‌توانم ثبت‌نام کنم؟', 'برای ثبت‌نام روی دکمه «ثبت‌نام» در صفحه ورود کلیک کنید و شماره موبایل خود را وارد نمایید.', 1, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(1, 'چگونه می‌توانم ثبت‌نام کنم؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="2" data-active="1">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="faq-order badge badge-light-secondary">2</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">آیا امکان بازگشت وجه وجود دارد؟</span></td>
                            <td class="text-center" data-order="1">
                                <span class="badge badge-light-success">فعال</span>
                            </td>
                            <td data-order="2026-09-20"><span class="text-gray-600">۱۴۰۴/۰۶/۲۹</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1"
                                        onclick="openDetailsModal('آیا امکان بازگشت وجه وجود دارد؟', 'در صورت عدم رضایت، طبق قوانین سایت تا ۷ روز پس از خرید امکان بازگشت وجه وجود دارد.')" title="جزئیات">
                                    <i class="ki-duotone ki-eye fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(2, 'آیا امکان بازگشت وجه وجود دارد؟', 'در صورت عدم رضایت، طبق قوانین سایت تا ۷ روز پس از خرید امکان بازگشت وجه وجود دارد.', 2, true)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(2, 'آیا امکان بازگشت وجه وجود دارد؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>

                        <tr data-id="3" data-active="0">
                            <td class="dtr-control-col"></td>
                            <td tabindex="0" class="reorder text-center dt-type-numeric dtr-control">
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="ki-duotone ki-burger-menu-2 fs-2 text-gray-400 cursor-move me-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span><span class="path6"></span>
                                        <span class="path7"></span><span class="path8"></span><span class="path9"></span><span class="path10"></span>
                                    </i>
                                    <span class="faq-order badge badge-light-secondary">3</span>
                                </div>
                            </td>
                            <td><span class="text-gray-800 fw-bold">آیا دوره‌ها به صورت حضوری برگزار می‌شوند؟</span></td>
                            <td class="text-center" data-order="0">
                                <span class="badge badge-light-danger">غیرفعال</span>
                            </td>
                            <td data-order="2026-10-01"><span class="text-gray-600">۱۴۰۴/۰۷/۰۹</span></td>
                            <td class="text-end nowrap-cell">
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-info me-1"
                                        onclick="openDetailsModal('آیا دوره‌ها به صورت حضوری برگزار می‌شوند؟', 'در حال حاضر تمامی دوره‌ها به صورت آنلاین برگزار می‌شوند.')" title="جزئیات">
                                    <i class="ki-duotone ki-eye fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary me-1"
                                        onclick="openEditModal(3, 'آیا دوره‌ها به صورت حضوری برگزار می‌شوند؟', 'در حال حاضر تمامی دوره‌ها به صورت آنلاین برگزار می‌شوند.', 3, false)" title="ویرایش">
                                    <i class="ki-duotone ki-pencil fs-2"><span class="path1"></span><span class="path2"></span></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-danger"
                                        onclick="openDeleteModal(3, 'آیا دوره‌ها به صورت حضوری برگزار می‌شوند؟')" title="حذف">
                                    <i class="ki-duotone ki-trash fs-2">
                                        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                                        <span class="path4"></span><span class="path5"></span>
                                    </i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_FaqModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/faqs.js"></script>
}
