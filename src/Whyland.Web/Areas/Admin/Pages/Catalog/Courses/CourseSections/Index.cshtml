@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Catalog.Courses.CourseSections.IndexModel
@{
    ViewData["Title"] = "سرفصل‌های دوره";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = "/Admin/Catalog/Courses", IsActive = false },
        new BreadcrumbItem { Title = "سرفصل‌های دوره", Url = null, IsActive = true }
    };
}

@Html.AntiForgeryToken()
<input type="hidden" id="courseId" value="@Model.CourseId" />

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css" type="text/css" />
    <link rel="stylesheet" href="~/admin/css/course-sections.css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت سرفصل‌ها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                دوره: <span class="text-gray-800">@Model.CourseTitle</span>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/Admin/Catalog/Courses" class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به دوره‌ها
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن سرفصل جدید
            </button>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <div class="card card-flush">
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <div class="d-flex align-items-center position-relative my-1">
                    <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-4">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    <input type="text" id="sectionSearch"
                           class="form-control form-control-solid w-250px ps-12"
                           placeholder="جستجو در سرفصل‌ها..." />
                </div>

                <div class="d-flex align-items-center text-muted fs-7">
                    <i class="ki-duotone ki-arrows-move fs-4 text-gray-500 me-1">
                        <span class="path1"></span><span class="path2"></span>
                    </i>
                    برای تغییر ترتیب، سطرها را از ستون «ترتیب» درگ کنید
                </div>
            </div>

            <div class="card-body pt-0">
                <table id="kt_course_sections_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-500px">عنوان سرفصل</th>
                            <th class="text-start w-150px">تعداد اپیزودها</th>
                            <th class="text-end nowrap-cell">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows are loaded and rendered by course-sections.js (?handler=Rows). -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->

<partial name="_CourseSectionModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/course-sections.js"></script>
}
