@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Catalog.Courses.CoursesModel
@{
    ViewData["Title"] = "دوره‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = null, IsActive = true }
    };
}

@* Antiforgery token required by the multipart POST handlers (read by courses.js). *@
@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <style>
        /* #region TinyMCE z-index fixes — dialogs and menus must render above the fullscreen modal */
        .tox-tinymce-aux,
        .tox .tox-dialog-wrap,
        .tox .tox-silver-sink { z-index: 2000 !important; }
        .tox-tinymce { border-radius: .475rem !important; border-color: var(--bs-gray-300, #dbdfe9) !important; }
        /* #endregion */

        /* A long category/instructor list belongs inside the modal card, not the page. */
        .course-choice-select { min-height: 150px; }

        /* The full HTML description is admin-authored content; keep it inside the modal. */
        .course-details-description { min-height: 120px; overflow-wrap: anywhere; }

        /* A long course name is clamped instead of stretching its DataTable column. */
        .course-name-text {
            display: -webkit-box;
            max-width: 300px;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            line-height: 1.7;
            overflow-wrap: anywhere;
            white-space: normal;
        }
    </style>
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت دوره‌ها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                ایجاد، ویرایش و حذف دوره‌ها؛ فیلتر بر اساس دسته‌بندی، مدرس و همهٔ ستون‌های جدول
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن دوره جدید
            </button>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header - generic filter picker-->
            <div class="card-header align-items-center py-5 flex-wrap gap-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="fs-7 fw-semibold text-muted" for="filterField">فیلتر روی:</label>
                    <select id="filterField" class="form-select form-select-solid w-175px"></select>
                    <select id="filterOperator" class="form-select form-select-solid w-150px" dir="ltr"></select>
                    <div id="filterValueWrap" class="d-flex align-items-center"></div>
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                            title="افزودن فیلتر" onclick="addFilterCondition()">
                        <i class="ki-duotone ki-plus fs-2"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light" onclick="clearFilterConditions()">
                        پاک کردن فیلترها
                    </button>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Active conditions-->
            <div id="filterChips" class="d-flex flex-wrap gap-2 px-5 pb-3"></div>
            <!--end::Active conditions-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_courses_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="text-center w-75px">تصویر</th>
                            <th class="text-start w-300px">نام دوره</th>
                            <th class="text-start w-175px">دسته‌بندی</th>
                            <th class="text-start w-175px">مدرس</th>
                            <th class="text-start w-150px">قیمت (تومان)</th>
                            <th class="text-center w-110px">وضعیت</th>
                            <th class="text-start w-100px">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows are loaded and rendered by courses.js (?handler=Rows). -->
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_CourseModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/tinymce/tinymce.bundle.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/common/admin-table.js"></script>
    <script src="~/admin/js/common/html-editor.js"></script>
    <script src="~/admin/js/courses.js"></script>
}
