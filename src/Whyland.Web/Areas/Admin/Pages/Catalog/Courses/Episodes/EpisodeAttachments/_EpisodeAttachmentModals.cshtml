<!--begin::Upload Modal-->
<div class="modal fade" id="kt_modal_attachment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15">
                <form id="kt_modal_attachment_form" class="form" onsubmit="return false;">
                    <!--begin::Heading-->
                    <div class="mb-13 text-center">
                        <h1 class="mb-3" id="modal-attachment-title">افزودن پیوست</h1>
                        <div class="text-muted fw-semibold fs-5">
                            فایل پیوست اپیزود را انتخاب کنید
                        </div>
                    </div>
                    <!--end::Heading-->

                    <!--begin::Upload limits-->
                    <div class="notice d-flex bg-light-warning rounded border-warning border border-dashed mb-9 p-6">
                        <i class="ki-duotone ki-information-4 fs-2tx text-warning me-4">
                            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                        </i>
                        <div class="d-flex flex-column fw-semibold">
                            <div class="text-gray-800 fs-6 mb-1">محدودیت‌های آپلود پیوست</div>
                            <div class="text-muted fs-7">
                                حداکثر تعداد: <span class="text-gray-800" id="limit-max-count">@Model.MaxAttachmentsPerEpisode</span>
                                <span class="mx-1">|</span>
                                حداکثر حجم هر فایل: <span class="text-gray-800" id="limit-max-size">@Model.MaxAttachmentSizeDisplay</span>
                                <span class="mx-1">|</span>
                                پسوندهای مجاز: <span class="text-gray-800" id="limit-allowed-exts" dir="ltr">@Model.AllowedExtensionsDisplay</span>
                            </div>
                        </div>
                    </div>
                    <!--end::Upload limits-->

                    <!--begin::Input group - File-->
                    <div class="fv-row mb-8">
                        <label class="required fs-6 fw-semibold mb-2">فایل پیوست</label>
                        <input type="file" id="Form_AttachmentFile" name="Form_AttachmentFile"
                               class="form-control form-control-solid"
                               data-max-count="@Model.MaxAttachmentsPerEpisode"
                               data-max-size-bytes="@Model.MaxAttachmentSizeBytes"
                               accept="@string.Join(",", Model.AllowedAttachmentExtensions)" />
                        <div class="text-muted fs-7 mt-1">
                            پس از انتخاب فایل، نام و نوع و حجم آن به‌صورت خودکار نمایش داده می‌شود
                        </div>
                    </div>
                    <!--end::Input group-->

                    <!--begin::Actions-->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-light me-3" data-bs-dismiss="modal">انصراف</button>
                        <button type="button" class="btn btn-primary" id="kt_modal_attachment_submit"
                                onclick="submitAttachmentForm()">
                            <span class="indicator-label">آپلود و ذخیره</span>
                            <span class="indicator-progress">
                                لطفاً صبر کنید...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>

<!--end::Upload Modal-->

<!--begin::Delete Confirmation Modal-->
<div class="modal fade" id="kt_modal_delete_attachment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content rounded">
            <!--begin::Modal header-->
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <!--end::Modal header-->

            <!--begin::Modal body-->
            <div class="modal-body text-center pt-0 pb-15 px-10">
                <i class="ki-duotone ki-trash fs-5x text-danger mb-5">
                    <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                    <span class="path4"></span><span class="path5"></span>
                </i>

                <h2 class="mb-3">حذف پیوست</h2>

                <div class="text-muted fw-semibold fs-5 mb-8">
                    آیا از حذف فایل
                    <span class="fw-bold text-gray-900" id="delete-attachment-name" dir="ltr"></span>
                    مطمئن هستید؟
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <span class="indicator-label">بله، حذف شود</span>
                        <span class="indicator-progress">
                            لطفاً صبر کنید...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
            <!--end::Modal body-->
        </div>
    </div>
</div>

<!--end::Delete Confirmation Modal-->
