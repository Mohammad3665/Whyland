@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Catalog.Courses.Episodes.IndexModel
@{
    ViewData["Title"] = "اپیزودها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دوره‌ها", Url = "/Admin/Catalog/Courses", IsActive = false },
        new BreadcrumbItem { Title = "سرفصل‌های دوره", Url = $"/Admin/Catalog/Courses/CourseSections?courseId={Model.CourseId}",
IsActive = false },
        new BreadcrumbItem { Title = "اپیزودها", Url = null, IsActive = true }
    };
}

@Html.AntiForgeryToken()
<input type="hidden" id="courseId" value="@Model.CourseId" />
<input type="hidden" id="sectionId" value="@Model.SectionId" />

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css"
          type="text/css" />
    <link rel="stylesheet" href="~/admin/css/episodes.css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container"
         class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت اپیزودها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                دوره: <span class="text-gray-800">@Model.CourseTitle</span>
                <span class="mx-1">|</span>
                سرفصل: <span class="text-gray-800">@Model.SectionTitle</span>
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <a href="/Admin/Catalog/Courses/CourseSections?courseId=@Model.CourseId"
               class="btn btn-sm fw-bold btn-light">
                <i class="ki-duotone ki-arrow-left fs-4 me-1"></i>
                بازگشت به سرفصل‌ها
            </a>
            <button type="button" class="btn btn-sm fw-bold btn-primary" onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن اپیزود جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Generic filter picker-->
            <div class="card-header align-items-center py-4 flex-wrap gap-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="fs-7 fw-semibold text-muted" for="filterField">فیلتر روی:</label>
                    <select id="filterField" class="form-select form-select-solid w-175px"></select>
                    <select id="filterOperator" class="form-select form-select-solid w-150px" dir="ltr"></select>
                    <div id="filterValueWrap" class="d-flex align-items-center"></div>
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                            title="افزودن فیلتر" onclick="addFilterCondition()">
                        <i class="ki-duotone ki-plus fs-2"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light" onclick="clearFilterConditions()">
                        پاک کردن فیلترها
                    </button>
                </div>
            </div>
            <div id="filterChips" class="d-flex flex-wrap gap-2 px-5 pb-3"></div>
            <!--end::Generic filter picker-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_episodes_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-350px">عنوان اپیزود</th>
                            <th class="text-start nowrap-cell">مدت زمان</th>
                            <th class="text-start nowrap-cell">ویدیو</th>
                            <th class="text-start nowrap-cell">پیوست‌ها</th>
                            <th class="text-start">رایگان</th>
                            <th class="text-start nowrap-cell">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows are loaded and rendered by episodes.js (?handler=Rows). -->
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_EpisodeModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/common/admin-table.js"></script>
    <script src="~/admin/js/episodes.js"></script>
}
