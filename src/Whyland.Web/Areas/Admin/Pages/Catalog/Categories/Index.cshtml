@page
@using Whyland.Web.Areas.Admin.Models
@model Whyland.Web.Areas.Admin.Pages.Catalog.Categories.CategoriesModel
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پنل مدیریت", Url = "/Home/Index", IsActive = false },
        new BreadcrumbItem { Title = "دسته‌بندی‌ها", Url = null, IsActive = true }
    };
}

@* Antiforgery token required by the modal POST handlers (read by categories.js). *@
@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/datatables/datatables.bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/admin/assets/plugins/custom/orderable-datatables/rowReorder.datatables.min.css" type="text/css" />
    @* Select2 placement + five-row scroll cap for the «والد» picker in the modal. *@
    <link rel="stylesheet" href="~/admin/css/categories.css" type="text/css" />
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-column flex-sm-row align-items-start align-items-lg-center justify-content-between gap-3">

        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0">
                مدیریت دسته‌بندی‌ها
            </h1>
            <div class="text-muted fw-semibold fs-7 pt-2">
                ساختار درختی دسته‌بندی دوره‌ها (حداکثر ۳ سطح، هر دسته حداکثر ۳ زیرمجموعه)
            </div>
        </div>

        <!--begin::Actions-->
        <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3">
            <button type="button" class="btn btn-sm fw-bold btn-primary"
                    data-bs-toggle="modal" data-bs-target="#kt_modal_category"
                    onclick="openCreateModal()">
                <i class="ki-duotone ki-plus fs-4 me-1"></i>
                افزودن دسته‌بندی جدید
            </button>
        </div>
        <!--end::Actions-->
    </div>
</div>
<!--end::Toolbar-->

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">

        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header - generic filter picker-->
            <!-- Same picker as the users list: the field list and the operators of each field come
                 from ?handler=Fields, so any category column - including the parent name and the
                 tree level - can be searched, filtered or sorted without markup changes. The
                 conditions are resolved server-side by the same engine the users table uses. -->
            <div class="card-header align-items-center py-5 flex-wrap gap-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <label class="fs-7 fw-semibold text-muted" for="filterField">فیلتر روی:</label>
                    <select id="filterField" class="form-select form-select-solid w-175px"></select>
                    <select id="filterOperator" class="form-select form-select-solid w-150px" dir="ltr"></select>
                    <!-- The value control is rebuilt from the selected field kind (text, number,
                         date or an option list), so no field needs its own markup. -->
                    <div id="filterValueWrap" class="d-flex align-items-center"></div>
                    <button type="button" class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary"
                            title="افزودن فیلتر" onclick="addFilterCondition()">
                        <i class="ki-duotone ki-plus fs-2"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light" onclick="clearFilterConditions()">
                        پاک کردن فیلترها
                    </button>
                </div>
            </div>
            <!--end::Card header-->

            <!--begin::Active conditions-->
            <div id="filterChips" class="d-flex flex-wrap gap-2 px-5 pb-3"></div>
            <!--end::Active conditions-->

            <!--begin::Card body-->
            <div class="card-body pt-0">
                <table id="kt_categories_table" class="table table-striped table-row-bordered gy-5 gs-7 align-middle">
                    <thead>
                        <tr class="fw-semibold fs-6 text-gray-800 text-start">
                            <th class="dtr-control-col w-25px"></th>
                            <th class="text-center w-100px">ترتیب</th>
                            <th class="text-start w-300px">نام</th>
                            <th class="text-start w-200px">نام لاتین</th>
                            <th class="text-start w-200px">والد</th>
                            <th class="text-center w-100px">وضعیت</th>
                            <th class="text-start nowrap-cell">تاریخ ایجاد</th>
                            <th class="text-start">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows are loaded and rendered by categories.js (?handler=Rows). -->
                    </tbody>
                </table>
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->

<partial name="_CategoryModals" />

@section Scripts {
    <script src="~/admin/assets/plugins/custom/datatables/datatables.bundle.js"></script>
    <script src="~/admin/assets/plugins/custom/orderable-datatables/datatables.rowReorder.min.js"></script>
    <script src="~/admin/js/common/admin-crud.js"></script>
    <script src="~/admin/js/categories.js"></script>
}
