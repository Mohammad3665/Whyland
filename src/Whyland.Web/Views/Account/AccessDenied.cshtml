@{
  ViewData["Title"] = "دسترسی ندارید | وایلند";
}

<!-- #region EXPLAINER -->
<!--
  This page is where the cookie handler sends an authenticated request that a policy rejected
  (AccessDeniedPath). It must not be the sign-in page: the session is valid, only the permission is
  missing, and asking for a password again fixes neither.
-->
<div class="container-whyland px-4 py-16 sm:py-24">
  <div class="mx-auto max-w-xl rounded-2xl border border-border bg-white p-6 text-center sm:p-10">
    <h1 class="text-xl font-bold text-dark sm:text-2xl">اجازهٔ ورود به این بخش را ندارید</h1>
    <p class="mt-4 text-sm leading-7 text-body sm:text-base">
      شما با حساب
      <span class="font-semibold text-dark">@User.Identity?.Name</span>
      وارد شده‌اید، ولی این حساب کلید دسترسی لازم برای این صفحه را ندارد. اگر فکر می‌کنید این دسترسی باید به
      شما داده شده باشد، به مدیر سامانه بگویید؛ بعد از افزودن دسترسی، لازم نیست دوباره وارد شوید.
    </p>

    <!-- #region ACTIONS -->
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a asp-controller="Home" asp-action="Index"
         class="inline-flex items-center justify-center rounded-full button-primary px-6 py-2.5 text-xs sm:text-sm">
        صفحهٔ اصلی
      </a>
      <form method="post" asp-controller="Account" asp-action="Logout" class="w-full sm:w-auto">
        @Html.AntiForgeryToken()
        <button type="submit"
                class="w-full cursor-pointer rounded-full border border-border px-6 py-2.5 text-xs font-semibold text-dark transition-colors duration-300 hover:border-primary hover:bg-primary hover:text-white active:scale-95 sm:w-auto sm:text-sm">
          خروج و ورود با حساب دیگر
        </button>
      </form>
    </div>
    <!-- endregion -->
  </div>
</div>
<!-- endregion -->
