{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=whyland;Username=postgres"
  },
  "Sms": {
    "Provider": "WhylandSms"
  },
  "SmsProvider": {
    "BaseUrl": "http://localhost:5090",
    "ApiKey": "dev-only-sms-key",
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
