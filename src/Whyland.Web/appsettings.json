{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=whyland;Username=postgres;Password=postgres"
  },
  "Sms": {
    "Provider": "WhylandSms"
  },
  "Auth": {
    "OtpCodeLength": 6,
    "OtpExpiryMinutes": 2,
    "OtpMaxAttempts": 5,
    "OtpResendCooldownSeconds": 60,
    "OtpSmsTemplateCode": "SMS-OTP-001",
    "PasswordMinLength": 8,
    "PasswordMaxFailedAttempts": 5,
    "PasswordLockoutMinutes": 15
  },
  "Admin": {
    "PhoneNumber": "09120000000",
    "Email": "admin@whyland.local"
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads/images",
    "Areas": {
      "Course": "courses",
      "Instructor": "instructors",
      "Blog": "blogs"
    },
    "MaxFileSizeBytes": 10485760
  },
  "EpisodeVideo": {
    "RootPath": "wwwroot/uploads/media",
    "VideoDirectory": "videos",
    "MaxFileSizeBytes": 524288000,
    "MaxDurationSeconds": 86400
  },
  "EpisodeAttachment": {
    "RootPath": "wwwroot/uploads/media",
    "AttachmentDirectory": "files",
    "MaxAttachmentSizeBytes": 104857600,
    "MaxAttachmentsPerEpisode": 10,
    "AllowedExtensions": [
      ".pdf",
      ".zip",
      ".rar",
      ".7z",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".mp3"
    ]
  },
  "SmsProvider": {
    "BaseUrl": "http://localhost:5090",
    "ApiKey": "dev-only-sms-key",
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
