{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=whyland;Username=postgres"
  },
  "Sms": {
    "Provider": "WhylandSms"
  },
  "Auth": {
    "OtpCodeLength": 6,
    "OtpExpiryMinutes": 2,
    "OtpMaxAttempts": 5,
    "OtpResendCooldownSeconds": 60,
    "OtpSmsTemplateCode": "SMS-OTP-001",
    "PasswordMinLength": 8,
    "PasswordMaxFailedAttempts": 5,
    "PasswordLockoutMinutes": 15
  },
  "Admin": {
    "PhoneNumber": "09120000000",
    "Email": "admin@whyland.local"
  },
  "SmsProvider": {
    "BaseUrl": "http://localhost:5090",
    "ApiKey": "dev-only-sms-key",
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
