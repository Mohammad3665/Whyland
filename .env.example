# Copy this file to .env (next to compose.yaml) and adjust the values.
# compose.yaml and compose.debug.yaml interpolate these variables automatically.

# Password used by the postgres service and the web app connection string.
WHYLAND_POSTGRES_PASSWORD=change-me

# Shared key between the web app and the Whyland.Sms service.
# Sent as the X-Sms-Api-Key header; must match SmsService__ApiKey on the SMS container.
WHYLAND_SMS_API_KEY=change-me

# Sign-in for the SMS dashboard served by the same container (http://localhost:5090).
# The panel refuses to open when the password is empty; keep this out of git.
WHYLAND_SMS_PANEL_USERNAME=panel
WHYLAND_SMS_PANEL_PASSWORD=change-me

# Optional: Google sign-in. Every person running this project creates their own OAuth client at
# https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID
# -> type "Web application", then adds these Authorized redirect URIs:
#     http://localhost:5000/signin-google   (docker compose)
#     https://localhost:7010/signin-google  (dotnet run, https profile)
# and publishes the OAuth consent screen (Testing mode only lets listed emails sign in).
# Leave both empty to run without the Google button; see Documentation/Whyland-Auth-Setup.md.
WHYLAND_GOOGLE_CLIENT_ID=
WHYLAND_GOOGLE_CLIENT_SECRET=

# Optional: full override of the app connection string (whylandweb container).
# When set, ConnectionStrings__Postgres in compose files must be adjusted too.
# WHYLAND_POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=whyland;Username=postgres;Password=change-me
